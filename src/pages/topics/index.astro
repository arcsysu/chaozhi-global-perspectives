---
/**
 * 主题页 (/topics/)
 *
 * 从已发布文章的 tags 字段自动汇总全部主题。
 * 对标签去重，统计每个主题的文章数量。
 * 主题按文章数量降序排列，同数量时按名称排序。
 * 点击主题，进入对应的文章合集页面。
 *
 * 主题名称可能包含中文、空格、+ 等字符，URL 编码处理。
 * 新文章出现新标签时，重新构建即可自动生成对应主题。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import '@/styles/page.css';
import { getTagStats } from '@/utils/articles';
import { withBase } from '@/utils/site';

const tagStats = await getTagStats();
---

<BaseLayout title="主题">
  <Container>
    <section class="page-header">
      <h1 class="page-header__title">主题</h1>
      <p class="page-header__subtitle">
        按主题合集浏览 HPC 与 AI for Science 领域的观察文章。主题由文章标签自动聚合生成，共 {tagStats.length} 个主题。
      </p>
    </section>

    <section class="stack" aria-label="主题列表">
      {
        tagStats.length === 0 ? (
          <p class="empty-state">暂无主题，文章发布后将自动生成。</p>
        ) : (
          <ul role="list" class="topic-grid">
            {tagStats.map(({ tag, count }) => (
              <li>
                <a href={withBase(`/topics/${encodeURIComponent(tag)}/`)} class="topic-item">
                  <span class="topic-item__name">{tag}</span>
                  <span class="topic-item__count">{count} 篇</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </Container>
</BaseLayout>

<style>
  .topic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-sm);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .topic-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-lg);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .topic-item:hover {
    border-color: var(--color-brand-border);
    box-shadow: var(--shadow-card);
  }

  .topic-item__name {
    font-size: var(--fs-base);
    font-weight: var(--fw-medium);
    color: var(--color-heading);
  }

  .topic-item__count {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    background-color: var(--color-brand-soft);
    padding: var(--space-2xs) var(--space-sm);
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  .empty-state {
    padding: var(--space-2xl);
    text-align: center;
    color: var(--color-text-muted);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
</style>
