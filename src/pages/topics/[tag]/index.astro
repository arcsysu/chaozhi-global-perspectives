---
/**
 * 主题合集页 (/topics/[tag]/)
 *
 * 展示指定标签下的全部已发布文章，按发布时间倒序。
 * 复用 ArticleList 组件。
 *
 * 路由参数 tag 为 URL 编码的主题名称。
 * 通过 getStaticPaths 预生成所有标签对应的静态页面。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import ArticleList from '@/components/ArticleList.astro';
import Pagination from '@/components/Pagination.astro';
import '@/styles/page.css';
import { getTagStats, getArticlesByTag } from '@/utils/articles';
import { withBase } from '@/utils/site';
import { paginate } from '@/utils/pagination';

export async function getStaticPaths() {
  const tagStats = await getTagStats();
  // 注意：Astro 会自动对 getStaticPaths 的 params 值进行 URL 编码，
  // 此处传入原始（未编码）tag 即可，切勿 encodeURIComponent 否则双重编码导致路由不匹配。
  return tagStats.map(({ tag }) => ({
    params: { tag },
    props: { tag },
  }));
}

interface Props {
  tag: string;
}

const { tag } = Astro.props;
const allArticles = await getArticlesByTag(tag);
const page1 = paginate(allArticles, 1);
---

<BaseLayout title={`主题：${tag}`}>
  <Container>
    <section class="page-header">
      <nav class="breadcrumb" aria-label="面包屑">
        <a href={withBase('/topics/')}>主题</a>
        <span aria-hidden="true">/</span>
        <span class="breadcrumb__current">{tag}</span>
      </nav>
      <h1 class="page-header__title">{tag}</h1>
      <p class="page-header__subtitle">
        共 {allArticles.length} 篇文章，按发布时间倒序排列。
      </p>
    </section>

    <section class="stack" id="latest-articles" aria-label={`${tag} 主题文章`}>
      <ArticleList articles={page1.items} showTags={false} emptyText="该主题暂无文章" />
      <Pagination
        basePath={`/topics/${encodeURIComponent(tag)}/`}
        current={page1.page}
        pages={page1.pages}
        total={page1.total}
        anchor="#latest-articles"
      />
    </section>
  </Container>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .breadcrumb a {
    color: var(--color-brand);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-brand-strong);
  }

  .breadcrumb__current {
    color: var(--color-heading);
    font-weight: var(--fw-medium);
  }
</style>
