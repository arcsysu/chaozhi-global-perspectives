---
/**
 * 首页 (/)
 *
 * 展示已发布文章列表，按发布时间倒序。
 * 单列线性排列，每篇展示标题、摘要、来源时间和可选左侧缩略图。
 * 首页不显示文章标签。
 *
 * 开发环境额外展示 Demo 文章预览区（明确标记，生产构建不生成）。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import ArticleList from '@/components/ArticleList.astro';
import '@/styles/page.css';
import { site } from '@/utils/site';
import { getThumbnailedArticles, getDemoArticleMetas } from '@/utils/articles';

const articles = await getThumbnailedArticles();

// 开发环境加载 Demo 文章预览
const demoArticles = import.meta.env.DEV ? await getDemoArticleMetas() : [];
---

<BaseLayout title="首页" appendSiteName={false}>
  <Container>
    <!-- 首页 Hero：品牌名称 + 宣传语 + 定位说明 -->
    <section class="page-hero">
      <h1 class="page-hero__title">{site.name}</h1>
      <p class="page-hero__slogan">{site.slogan}</p>
      <p class="page-hero__desc">
        {site.team} 团队围绕 {site.direction}
        前沿观察计划建设的科技信息展示平台。持续追踪 HPC 与 AI for Science
        领域的全球动态，呈现观察成果。
      </p>
    </section>

    <!-- 已发布文章列表 -->
    <section class="stack" aria-label="最新文章">
      <h2 class="section-title">最新文章</h2>
      <ArticleList articles={articles} limit={15} />
    </section>

    <!-- 开发环境 Demo 预览区 -->
    {
      demoArticles.length > 0 && (
        <section class="stack demo-section" aria-label="Demo 预览">
          <h2 class="section-title">
            本地 Demo 预览
            <span class="demo-section__hint">（仅开发环境可见，生产构建不生成）</span>
          </h2>
          <p class="demo-section__desc">
            以下为内部报告与测试文章，供排版效果预览。生产构建时此区域完全隔离，不出现在线上站点。
          </p>
          <ArticleList
            articles={demoArticles}
            linkPrefix="/demo/"
            emptyText="无 Demo 文章"
          />
        </section>
      )
    }
  </Container>
</BaseLayout>

<style>
  .section-title {
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
    color: var(--color-heading);
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--color-brand-border);
    margin-bottom: var(--space-md);
  }

  .demo-section {
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    border-top: 2px dashed var(--color-brand-border);
  }

  .demo-section__hint {
    font-size: var(--fs-sm);
    font-weight: var(--fw-regular);
    color: var(--color-text-muted);
  }

  .demo-section__desc {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
    padding: var(--space-sm) var(--space-md);
    background-color: #fef3c7;
    border-radius: var(--radius-sm);
    color: #92400e;
  }
</style>
