---
/**
 * 首页 (/) — 分页第一页
 *
 * 使用 HomeLayout 渲染完整首页结构（Hero + 粒子背景 + 最新文章列表）。
 * 第 2 页及之后由 /page/[page]/index.astro 渲染，同样使用 HomeLayout，
 * 确保直接访问 /page/N/ 时也是完整首页。
 *
 * 客户端分页逻辑封装在 HomeLayout 的 <script> 中：
 * 点击分页链接 → fetch 目标页 → 提取 #home-article-list 局部替换 →
 * History API 更新 URL，不整页刷新。
 */
import HomeLayout from '@/layouts/HomeLayout.astro';
---

<HomeLayout page={1} />
