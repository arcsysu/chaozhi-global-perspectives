---
/**
 * 年份合集页 (/archive/[year]/)
 *
 * 展示指定年份的全部已发布文章，按发布时间倒序。
 * 复用 ArticleList 组件。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import ArticleList from '@/components/ArticleList.astro';
import '@/styles/page.css';
import { getArchiveTree, getArticlesByYear } from '@/utils/articles';
import { withBase } from '@/utils/site';

export async function getStaticPaths() {
  const tree = await getArchiveTree();
  return tree.map((node) => ({
    params: { year: node.year },
    props: { year: node.year },
  }));
}

interface Props {
  year: string;
}

const { year } = Astro.props;
const articles = await getArticlesByYear(year);
---

<BaseLayout title={`${year} 年归档`}>
  <Container>
    <section class="page-header">
      <nav class="breadcrumb" aria-label="面包屑">
        <a href={withBase('/archive/')}>时间树</a>
        <span aria-hidden="true">/</span>
        <span class="breadcrumb__current">{year} 年</span>
      </nav>
      <h1 class="page-header__title">{year} 年</h1>
      <p class="page-header__subtitle">
        共 {articles.length} 篇文章，按发布时间倒序排列。
      </p>
    </section>

    <section class="stack" aria-label={`${year}年文章`}>
      <ArticleList articles={articles} showTags={true} emptyText="该年份暂无文章" />
    </section>
  </Container>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .breadcrumb a {
    color: var(--color-brand);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-brand-strong);
  }

  .breadcrumb__current {
    color: var(--color-heading);
    font-weight: var(--fw-medium);
  }
</style>
