---
/**
 * HomeLayout.astro — 首页布局（含 Hero + 粒子背景 + 最新文章列表）
 *
 * 被 index.astro（第一页）和 /page/[page]/index.astro（第 2 页起）共用，
 * 确保直接访问 /page/2/ 时也渲染完整首页结构（Hero + 粒子 + Header + Footer）。
 *
 * 客户端分页：
 * - 点击分页链接时，JS 拦截默认跳转，fetch 目标页面 HTML，
 *   提取 #home-article-list 内容进行局部替换。
 * - 使用 History API 更新 URL（/page/2/），不整页刷新。
 * - popstate 时检查 DOM 页码与 URL 页码是否一致，不一致才 fetch+swap。
 * - bfcache 恢复时 DOM 已正确，无需 swap。
 * - 无 JS 后备：分页链接是真正的 <a href>，直接访问 /page/N/ 渲染完整首页。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleList from '@/components/ArticleList.astro';
import Pagination from '@/components/Pagination.astro';
import ParticleBackground from '@/components/ParticleBackground.astro';
import ScienceMap from '@/components/ScienceMap.astro';
import '@/styles/page.css';
import { withBase } from '@/utils/site';
import { getMergedThumbnailedArticles } from '@/utils/articles';
import { paginate } from '@/utils/pagination';

interface Props {
  page?: number;
}

const { page = 1 } = Astro.props;
const allArticles = await getMergedThumbnailedArticles();
const result = paginate(allArticles, page);

const pageTitle = page === 1 ? '首页' : `最新文章 · 第 ${page} 页`;
const appendSiteName = page === 1 ? false : true;
---

<BaseLayout title={pageTitle} appendSiteName={appendSiteName}>
  {/* 得意黑（Smiley Sans）字体：SIL OFL 1.1 开源，仅用于 Hero 标题。
    * font-display: swap → 加载前回退系统粗体，加载后无缝替换。
    * 通过 jsDelivr CDN 加载 woff2，不增加构建依赖。 */}
  <link
    rel="preload"
    href="https://cdn.jsdelivr.net/npm/cn-fontsource-smiley-sans-oblique@1.1.0/font.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/cn-fontsource-smiley-sans-oblique@1.1.0/font.css"
  />

  {/* 动态粒子背景：fixed 覆盖整视口，z-index:-1，作为全页底色层 */}
  <ParticleBackground />

  {/* 全宽 Hero：左右两栏布局，叠在粒子背景上。
    * 左侧：标题 + 简介 + 按钮（约 52%）
    * 右侧：动态 Science Map（约 48%）
    * 桌面高度约 78vh，移动端改为上下布局 */}
  <section class="home-hero" id="top">
    <div class="home-hero__inner">
      {/* 左侧：宣传文字区 */}
      <div class="home-hero__left">
        <h1 class="home-hero__title">
          <span class="home-hero__title-line home-hero__title-line--1">看见科学的</span>
          <p class="home-hero__desc">
          
          </p>
          <span class="home-hero__title-line home-hero__title-line--2">下一步。</span>
        </h1>
        <p class="home-hero__desc">
          聚焦全球高性能计算与科学智能前沿，洞察计算、算法与科学发现之间的联系。
        </p>
        <div class="home-hero__actions">
          <a href="#latest-articles" class="home-hero__btn home-hero__btn--primary">
            浏览最新文章
          </a>
          <a href={withBase('/topics/')} class="home-hero__btn home-hero__btn--ghost">
            按主题探索
          </a>
        </div>
      </div>
      {/* 右侧：动态 Science Map */}
      <div class="home-hero__right">
        <ScienceMap />
      </div>
    </div>
  </section>

  <!-- 最新文章：浅色区域，内容宽度受约束、左对齐，右侧自然留白 -->
  <section class="home-latest" id="latest-articles" aria-label="最新文章">
    <div class="home-latest__inner">
      <h2 class="home-latest__title">最新文章</h2>
      {/* 文章列表容器：客户端分页时仅替换此 div 的 innerHTML。
       * data-page 用于 popstate 时判断 DOM 是否与 URL 匹配（避免 bfcache 恢复时重复 swap）。 */}
      <div id="home-article-list" data-page={result.page}>
        <ArticleList articles={result.items} />
        <Pagination
          basePath="/"
          current={result.page}
          pages={result.pages}
          total={result.total}
          anchor="#latest-articles"
        />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  /**
   * 首页客户端分页脚本
   *
   * 工作原理：
   * 1. 点击分页链接 → 拦截默认跳转 → fetch 目标 URL → 提取 #home-article-list → 局部替换
   * 2. pushState 更新 URL（不含 hash），不整页刷新
   * 3. popstate 时检查 data-page 与 URL 页码是否一致，不一致才 fetch+swap
   * 4. bfcache 恢复时 DOM 已正确（data-page 匹配），跳过 swap
   * 5. fetch 失败时回退为整页跳转（渐进增强）
   * 6. 支持 prefers-reduced-motion（跳过淡入淡出和平滑滚动）
   *
   * 滚动定位策略（区分三种场景）：
   * - 主动点击分页：swap 完成后平滑滚动到 #latest-articles 标题（避开固定 Header）
   * - 浏览器前进/后退（popstate）：精确恢复该历史条目保存的 scrollY（瞬间定位，不平滑）
   * - 首次整页加载 / 直接访问 /page/N/：若 URL 不含 #latest-articles 锚点，
   *   且当前页码 > 1（即 /page/2/ 等），则瞬间定位到 #latest-articles 标题，
   *   避免停留在 Hero 顶部。第 1 页（/）保持顶部（Hero 即首屏内容）。
   *
   * ─── 二次滚动防御（关键）─────────────────────────
   * 根因：CSS `scroll-behavior: smooth`（本文件 <style> 中 :global(html)）会使
   * `scrollTo({behavior:'auto'})` 也变为平滑动画（CSSOM View 规范：'auto' 继承 CSS 值）。
   * 这导致 initHomeScrollPosition / popstate restore 的"瞬间定位"实际是 300ms 平滑动画，
   * 在动画期间若 Astro ClientRouter 的 onScrollEnd 或 astro:page-load 触发，
   * 可与正在进行的平滑滚动竞争，造成"先到标题再回顶部"的二次滚动。
   *
   * 修复要点：
   * A. 所有需要"瞬间定位"的场景（首次加载、popstate restore）一律用 `behavior:'instant'`，
   *    绕过 CSS scroll-behavior 平滑化（'instant' 不受 CSS 值影响）。
   * B. pushState 时保存当前真实 scrollY（而非占位 0），避免历史条目 scrollY=0 的脏数据。
   * C. 用 homeScrollReady 标志位防止 astro:page-load 触发的重复 init 与正在进行的
   *    分页 scroll 竞争（ClientRouter persist Header 后脚本不重新执行，但直达/刷新会重跑）。
   */
  const containerEl = document.getElementById('home-article-list');
  if (containerEl) {
    // 引入 definitively-typed const：避免 TS 在嵌套 async function 中丢失 narrowing
    const container: HTMLElement = containerEl;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let abortController: AbortController | null = null;

    /**
     * 分页滚动控制器标志位：
     * - false：尚未初始化或有进行中的分页操作
     * - true：初始化完成，可安全处理 popstate
     * 用于防止 astro:page-load 触发的 initHomeScrollPosition 与进行中的
     * fetchAndSwap→scrollToLatest 竞争（ClientRouter 站内导航直达时）。
     */
    let homeScrollReady = false;

    /** 从 URL 提取页码（/page/2/ → 2，/ → 1） */
    function getPageFromUrl(url: string): number {
      const match = url.match(/\/page\/(\d+)/);
      return match ? parseInt(match[1], 10) : 1;
    }

    /** 从完整 href 中提取干净的 pathname（去除 hash 和 origin） */
    function cleanUrl(href: string): string {
      try {
        const url = new URL(href, window.location.origin);
        return url.pathname + url.search;
      } catch {
        return href;
      }
    }

    /** 读取固定 Header 高度（与 CSS --height-header 一致），用于精确滚动偏移 */
    function getHeaderOffset(): number {
      // 桌面 4.5rem(72px) / 移动 4rem(64px)，取实际生效的 CSS 变量
      const cssVar = getComputedStyle(document.documentElement)
        .getPropertyValue('--height-header')
        .trim();
      const cssMobile = getComputedStyle(document.documentElement)
        .getPropertyValue('--height-header-mobile')
        .trim();
      const px = (val: string) => {
        const n = parseFloat(val);
        return isNaN(n) ? 0 : n * 16; // rem → px（html font-size 默认 16px）
      };
      const isMobile = window.matchMedia('(max-width: 768px)').matches;
      const h = isMobile ? px(cssMobile) : px(cssVar);
      // 兜底：变量缺失时用 72px
      return h > 0 ? h : 72;
    }

    /**
     * 精确滚动到 #latest-articles 标题顶部，考虑固定 Header 高度。
     * 使用 window.scrollTo 而非 scrollIntoView，避免列表内容高度变化时
     * 平滑动画目标位移导致落点不准。在 swap 后 DOM 稳定时计算 offsetTop。
     *
     * @param instant  true=瞬间定位（首次加载/popstate restore），false=平滑滚动（主动分页）
     *
     * 关键：CSS `:global(html){scroll-behavior:smooth}` 会使 `behavior:'auto'`
     * 也变为平滑动画。必须用 `'instant'`（CSSOM 规范保留值，不受 CSS 影响）
     * 才能实现真正的瞬间定位，避免 300ms 平滑窗口期间的滚动竞争。
     * prefers-reduced-motion 时所有滚动都走 instant。
     */
    function scrollToLatest(instant = false) {
      const target = document.getElementById('latest-articles');
      if (!target) return;
      // 用 offsetTop 累加 offsetParent 链得到文档绝对偏移
      let offset = 0;
      let el: HTMLElement | null = target;
      while (el) {
        offset += el.offsetTop;
        el = el.offsetParent as HTMLElement | null;
      }
      const headerOffset = getHeaderOffset();
      // 额外 8px 视觉间距，确保标题不被 Header 贴边
      const targetY = Math.max(0, offset - headerOffset - 8);
      const behavior: ScrollBehavior = (instant || reducedMotion) ? 'instant' : 'smooth';
      window.scrollTo({ top: targetY, behavior });
    }

    /** 将当前滚动位置保存到 history state（供 popstate 恢复） */
    function saveScrollState() {
      const state = history.state || {};
      history.replaceState({ ...state, scrollY: window.scrollY }, '');
    }

    /**
     * fetch 目标页面，提取 #home-article-list 内容并局部替换。
     * @param targetUrl  干净 URL（不含 hash）
     * @param options    scrollTo: 'latest'（滚到列表顶部）| 'restore'（恢复指定位置）
     */
    async function fetchAndSwap(
      targetUrl: string,
      options: { scrollTo?: 'latest' | 'restore'; restoreY?: number } = {}
    ): Promise<void> {
      // 取消上一个进行中的 fetch（快速连续点击分页时）
      if (abortController) abortController.abort();
      abortController = new AbortController();

      try {
        // 淡出当前列表
        if (!reducedMotion) {
          container.style.opacity = '0';
          await new Promise<void>((r) => setTimeout(r, 150));
        }

        const response = await fetch(targetUrl, { signal: abortController.signal });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const html = await response.text();
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const newList = doc.getElementById('home-article-list');
        if (!newList) throw new Error('#home-article-list not found in fetched page');

        // 替换列表内容（innerHTML 安全：fetch 同源页面，内容为构建时生成的静态 HTML）
        container.innerHTML = newList.innerHTML;
        // 更新 data-page（供下次 popstate 判断）
        container.dataset.page = newList.dataset.page;

        // 同步更新文档标题
        const newTitle = doc.querySelector('title');
        if (newTitle && newTitle.textContent) {
          document.title = newTitle.textContent;
        }

        // 淡入新列表
        if (!reducedMotion) {
          container.style.opacity = '1';
        }

        // 滚动处理：swap 完成、DOM 稳定后再定位
        if (options.scrollTo === 'restore' && options.restoreY != null) {
          // 历史恢复：精确恢复到进入文章前的原始滚动位置（瞬间，不平滑）
          // 用 'instant' 避免 CSS smooth 使 restore 变为动画，防止与
          // Astro onScrollEnd 的 scrollY 保存竞争。
          // （reducedMotion 不影响：restore 一律瞬间定位）
          window.scrollTo({ top: options.restoreY, behavior: 'instant' });
        } else {
          // 主动分页：平滑滚到 #latest-articles 标题
          scrollToLatest(false);
        }
      } catch (e) {
        // AbortError：被新的 fetch 取消，静默忽略
        if (e instanceof DOMException && e.name === 'AbortError') return;
        // 其他错误：回退为整页跳转（渐进增强保障）
        window.location.href = targetUrl;
      }
    }

    // ─── 事件委托：拦截分页链接点击 ───────────────────
    container.addEventListener('click', async (e: MouseEvent) => {
      const target = e.target;
      const link =
        target instanceof HTMLElement
          ? (target.closest('a.pagination__link') as HTMLAnchorElement | null)
          : null;
      if (!link) return;
      // 禁用状态（首页无上一页 / 末页无下一页）或当前页：不拦截
      if (link.getAttribute('aria-disabled') === 'true') return;
      if (link.classList.contains('pagination__link--current')) return;

      e.preventDefault();
      const targetUrl = cleanUrl(link.href);

      // 保存当前滚动位置（供后退时恢复）
      saveScrollState();

      // 推入新历史条目。
      // 关键：scrollY 保存当前真实位置（而非占位 0），避免历史条目携带脏的
      // scrollY=0。fetchAndSwap 完成后 scrollToLatest 会定位到标题，
      // Astro onScrollEnd（router.js:402-405）会随后将真实 scrollY 写入 state，
      // 但在 onScrollEnd 触发前若有 popstate/pageshow 恢复，这里保存的
      // 当前位置比 0 更安全（至少回到点击前的位置而非页面顶部）。
      const currentScrollY = window.scrollY;
      history.pushState({ homePagination: true, scrollY: currentScrollY }, '', targetUrl);

      // 标记进行中：防止 initHomeScrollPosition（若被 astro:page-load 触发）干扰
      homeScrollReady = false;

      // 局部替换列表
      await fetchAndSwap(targetUrl, { scrollTo: 'latest' });

      // 分页操作完成，恢复 ready 状态
      homeScrollReady = true;
    });

    // ─── popstate：浏览器前进/后退 ───────────────────
    window.addEventListener('popstate', () => {
      const url = window.location.pathname + window.location.search;
      const expectedPage = getPageFromUrl(url);
      const currentPage = parseInt(container.dataset.page || '1', 10);

      // DOM 页码与 URL 页码不一致 → 需要局部 swap
      // 一致 → bfcache 恢复或新页面加载，DOM 已正确，跳过 swap
      if (expectedPage !== currentPage) {
        const state = history.state;
        const restoreY =
          state && typeof state.scrollY === 'number' ? state.scrollY : 0;
        fetchAndSwap(url, { scrollTo: 'restore', restoreY });
      } else {
        // DOM 已匹配（bfcache 恢复）：恢复该条目保存的精确滚动位置。
        // 用 'instant' 而非默认 'auto'，避免 CSS scroll-behavior:smooth
        // 使 restore 变为动画，导致与 Astro 的 scroll 处理竞争。
        const state = history.state;
        const restoreY =
          state && typeof state.scrollY === 'number' ? state.scrollY : null;
        if (restoreY != null) {
          window.scrollTo({ top: restoreY, behavior: 'instant' });
        }
      }
    });

    // ─── 初始化：首次加载 / 直接访问 /page/N/ 的滚动定位 ───────────────────
    // 区分场景：
    // - 整页加载（navigate/reload）且 URL 在 /page/N/（N>1）且无 #latest-articles hash
    //   → 瞬间定位到 #latest-articles 标题（避免停在 Hero 顶部）
    // - 第 1 页（/）→ 保持顶部（Hero 即首屏）
    // - 带 #latest-articles hash → 浏览器原生锚点已处理，不重复干预
    // - popstate 恢复 → 走上面的 popstate 回调，不在此处理
    function initHomeScrollPosition() {
      const currentPage = getPageFromUrl(window.location.pathname);
      const hasHash = window.location.hash === '#latest-articles';
      // 仅当 >1 页（/page/2/ 等）且无锚点时定位；第1页保持 Hero 顶部
      if (currentPage > 1 && !hasHash) {
        // 首次加载用 instant（瞬间定位），避免首屏长距离平滑滚动。
        // 关键：不能用 'auto'——CSS scroll-behavior:smooth 会使 'auto'
        // 变为平滑动画，创建 300ms 窗口，期间 astro:page-load / Astro
        // onScrollEnd 可能触发并竞争，导致"先到标题再回顶部"的二次滚动。
        scrollToLatest(true);
      }
      // 保存初始滚动位置（供后续 popstate 恢复）
      saveScrollState();
      homeScrollReady = true;
    }

    // 使用 requestAnimationFrame 确保布局完成后获取正确 offsetTop / scrollY
    requestAnimationFrame(() => {
      initHomeScrollPosition();
    });
  }
</script>

<style>
  /* ─── Hero ───────────────────────────────────── */
  .home-hero {
    position: relative;
    width: 100%;
    /* 桌面端占满首屏（100vh）：最新文章需下滑才能看到 */
    min-height: 100vh;
    /* 将 Hero 上移至页面最顶端，覆盖 Header 的流式占位空间。
     * Header 为 position:sticky; z-index:100，渲染在 Hero 之上，
     * 透明 Header 即可透出粒子背景。 */
    margin-top: calc(-1 * var(--height-header, 4rem));
    /* 透明背景：让粒子背景层（position:fixed; z-index:-1）透出。 */
    background-color: transparent;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .home-hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--width-content, 72rem);
    margin-inline: auto;
    padding-inline: var(--space-xl, 2rem);
    /* 上大下小：让 Hero 文案整体略微下移，留出更多顶部呼吸空间 */
    padding-block: 6rem var(--space-3xl, 4rem);
    /* 左右两栏布局：左侧文字 52%，右侧 Science Map 48% */
    display: grid;
    grid-template-columns: 52% 48%;
    align-items: center;
    gap: var(--space-2xl, 3rem);
  }

  /* 左侧：标题 + 简介 + 按钮 */
  .home-hero__left {
    max-width: 30rem;
  }

  /* 右侧：Science Map 容器 */
  .home-hero__right {
    width: 100%;
    height: 380px;
    /* 限制最大尺寸，避免过大抢占标题空间 */
    max-width: 480px;
    max-height: 400px;
    margin-inline: auto;
    position: relative;
  }

  /* 主标题：得意黑（Smiley Sans），两行设计感排版
   * 第一行"看见科学的"深灰紫，第二行"下一步。"品牌紫
   * font-display: swap 确保加载前回退系统粗体 */
  .home-hero__title {
    font-family: 'Smiley Sans Oblique', var(--font-display);
    font-size: clamp(2.75rem, 6vw, 4.25rem); /* 44px ~ 68px */
    font-weight: var(--fw-bold, 700);
    line-height: 1.05; /* 紧凑行距，两行标题贴合 */
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .home-hero__title-line {
    display: block;
  }

  /* 第一行：深灰紫色 */
  .home-hero__title-line--1 {
    color: #2b2640;
  }

  /* 第二行：品牌紫色，略大 */
  .home-hero__title-line--2 {
    color: var(--color-brand, #6d4aff);
    font-size: 1.08em; /* 略放大，视觉强调 */
  }

  /* 简介：灰紫色，保证浅紫背景上的可读性 */
  .home-hero__desc {
    margin-top: var(--space-xl, 2rem);
    font-size: var(--fs-base, 1rem);
    line-height: var(--lh-normal, 1.6);
    color: #4a4660;
    max-width: 28rem;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md, 1rem);
    margin-top: var(--space-2xl, 3rem);
  }

  /* 入口按钮 */
  .home-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-sm, 0.75rem) var(--space-xl, 2rem);
    border-radius: var(--radius-pill, 999px);
    font-size: var(--fs-base, 1rem);
    font-weight: var(--fw-semibold, 600);
    text-decoration: none;
    transition:
      background-color var(--transition-fast, 150ms),
