---
/**
 * 文章详情页布局 (ArticleLayout) — 第四阶段三栏升级
 *
 * 桌面端三栏布局：
 *   左栏：章节目录（若有）或自然留白
 *   中栏：标题、发布时间、摘要、标签、横线、正文（Markdown 渲染）、下一篇导航
 *   右栏：复制链接按钮、引用来源卡片（脚注提取）
 *
 * 文章头部元信息顺序（所有断点统一）：
 *   返回首页 → 标题 → 发布时间 → 摘要 → 标签 → 细横线 → 正文
 *   不显示资料类型、Agent 生成时间、人工整理时间。
 *
 * 顶部固定阅读栏：标题离开视口后出现，显示精简标题 + 阅读进度条。
 *
 * 响应式：
 *   宽屏桌面（≥1024px）：完整三栏
 *   平板（768–1023px）：双栏（中正文 + 右来源）
 *   手机（<768px）：单栏，来源回退到文末（GFM 默认渲染）
 *
 * 复用已有组件：ArticleTOC、CopyLinkButton、ReadingProgressBar、ArticleNav、ArticleFootnotes。
 * 不引入 React/Vue/动画库，全部原生 JS + CSS。
 */
import BaseLayout from './BaseLayout.astro';
import ArticleTOC from '@/components/ArticleTOC.astro';
import type { Heading } from '@/components/ArticleTOC.astro';
import CopyLinkButton from '@/components/CopyLinkButton.astro';
import ReadingProgressBar from '@/components/ReadingProgressBar.astro';
import ArticleNav from '@/components/ArticleNav.astro';
import ArticleFootnotes from '@/components/ArticleFootnotes.astro';
import '@/styles/article-prose.css';
import { withBase } from '@/utils/site';

export interface ArticleHeadMeta {
  title: string;
  summary: string;
  tags: string[];
  articleSource: 'agent' | 'curated';
  agent?: string;
  sourceTimeLabel: string;
  sourceTimeIso: string;
  publishedAtLabel: string | null;
  publishedAtIso: string | null;
  isDemo?: boolean;
}

export interface NavItem {
  id: string;
  title: string;
}

interface Props {
  meta: ArticleHeadMeta;
  /** render() 返回的 headings 数据，用于自动目录 */
  headings?: Heading[];
  /** 文章 Markdown 源码（entry.body），用于脚注提取 */
  markdownBody?: string;
  /** 返回链接 */
  backHref?: string;
  backLabel?: string;
  /** 上一篇/下一篇导航项 */
  prev?: NavItem | null;
  next?: NavItem | null;
  /** 文章详情页链接前缀（/articles/ 或 /demo/） */
  linkPrefix?: string;
}

const {
  meta,
  headings = [],
  markdownBody = '',
  backHref = withBase('/'),
  backLabel = '返回上一页',
  prev = null,
  next = null,
  linkPrefix = '/articles/',
} = Astro.props;

const isDemo = meta.isDemo ?? false;
---

<BaseLayout title={meta.title} description={meta.summary}>
  {/* 固定阅读栏 + 进度条 */}
  <ReadingProgressBar title={meta.title} backHref={backHref} backLabel={backLabel} />

  {/* 三栏布局容器 */}
  <div class="article-layout">
    {/* 左栏：章节目录（无目录时自然留白，不再重复元信息） */}
    <aside class="article-layout__left" aria-label="章节目录">
      <div class="article-meta-sidebar">
        <ArticleTOC headings={headings} />
      </div>
    </aside>

    {/* 中栏：标题 → 发布时间 → 摘要 → 标签 → 横线 → 正文 + 导航 */}
    <main class="article-layout__main">
      {/* 返回入口（data-back-nav 供 JS 拦截，href 保留为无脚本回退） */}
      <nav class="article-back" aria-label="返回导航">
        <a href={backHref} class="article-back__link" data-back-nav data-back-href={backHref}>← {backLabel}</a>
        {isDemo && <span class="article-back__demo-tag">Demo 预览</span>}
      </nav>

      {/*
        文章头部（所有断点统一顺序）：
        标题 → 发布时间 → 斜体摘要 → 标签 → 细横线（由 article-head 的 border-bottom 承担）
        不显示资料类型、Agent 生成时间、人工整理时间。
      */}
      <header class="article-head">
        <h1 class="article-head__title">{meta.title}</h1>
        {
          meta.publishedAtLabel && (
            <time class="article-head__published" datetime={meta.publishedAtIso!}>
              {meta.publishedAtLabel}
            </time>
          )
        }
        <p class="article-head__summary">{meta.summary}</p>
        {
          meta.tags.length > 0 && (
            <div class="article-head__tags">
              {meta.tags.map((tag) => (
                <a
                  href={withBase(`/topics/${encodeURIComponent(tag)}/`)}
                  class="article-head__tag"
                >
                  {tag}
                </a>
              ))}
            </div>
          )
        }
      </header>

      {/* 文章正文（Markdown 渲染） */}
      <article class="article-prose article-body" id="article-body">
        <slot />
      </article>

      {/* 下一篇导航（ArticleNav 接收 next；单篇降级由工具层处理） */}
      <ArticleNav prev={prev} next={next} linkPrefix={linkPrefix} isDemo={isDemo} />
    </main>

    {/* 右栏：复制链接 + 引用来源 */}
    <aside class="article-layout__right" aria-label="辅助信息">
      <div class="article-aside">
        <CopyLinkButton />

        {/* 引用来源边注（从 Markdown 脚注提取） */}
        <ArticleFootnotes markdown={markdownBody} />
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  /**
   * 图片增强（Task E）：
   * 1. 为正文所有 <img> 添加 loading="lazy" + decoding="async"（懒加载、防布局偏移）
   * 2. 将带 title 属性的图片包裹为 <figure> + <figcaption>（图注）
   * 3. 大表格自动包裹 .table-wrapper（防溢出，窄屏可滚动）
   *
   * 生命周期：astro:page-load（每次页面加载后触发，含 ClientRouter 站内导航后）。
   * 原 DOMContentLoaded 在客户端导航时不触发，会导致从首页/列表点进文章后图片未增强。
   */
  function enhanceArticleBody() {
    const body = document.getElementById('article-body');
    if (!body) return;

    // 图片懒加载 + 图注
    const imgs = body.querySelectorAll('img');
    imgs.forEach((img) => {
      // 懒加载：非首屏图片延迟加载
      if (!img.hasAttribute('loading')) {
        img.setAttribute('loading', 'lazy');
      }
      if (!img.hasAttribute('decoding')) {
        img.setAttribute('decoding', 'async');
      }

      // 图注：title 属性转为 figcaption
      const title = img.getAttribute('title');
      if (title && img.parentElement?.tagName !== 'FIGURE') {
        const figure = document.createElement('figure');
        const figcaption = document.createElement('figcaption');
        figcaption.textContent = title;
        img.removeAttribute('title'); // 避免浏览器原生 tooltip 重复
        img.parentElement?.insertBefore(figure, img);
        figure.appendChild(img);
        figure.appendChild(figcaption);
      }
    });

    // 大表格自动包裹滚动容器（若未被 Markdown 插件包裹）
    const tables = body.querySelectorAll('table');
    tables.forEach((table) => {
      if (table.parentElement?.classList.contains('table-wrapper')) return;
      const wrapper = document.createElement('div');
      wrapper.className = 'table-wrapper';
      table.parentElement?.insertBefore(wrapper, table);
      wrapper.appendChild(table);
    });
  }

  // astro:page-load：每次页面加载后触发（含 ClientRouter 导航后进入文章页）。
  document.addEventListener('astro:page-load', enhanceArticleBody);
</script>

<script>
  /**
   * 返回导航增强（返回上一页）：
   * 优先使用 history.back() 恢复来源页面及滚动位置。
   *
   * ClientRouter 兼容性说明：
   * - history.back() 会触发 ClientRouter 的 popstate 处理，进行站内页面切换（不整页卸载）。
   * - 原实现依赖 document.referrer 判断站内来源 + pagehide 超时兜底。
   *   但客户端导航下 document.referrer 不更新（始终为首屏来源），且 pagehide 不触发，
   *   导致超时兜底误判 back() 失败 → 500ms 后整页跳转 fallbackHref，破坏导航体验。
   *
   * 改进：
   * - 站内来源判断改为 history.length > 1（标签页有历史可回退即可），
   *   不再依赖 document.referrer（客户端导航下不可靠）。
   * - 移除 pagehide 超时兜底：ClientRouter 下 back() 必然触发 popstate 页面切换，
   *   无需兜底；若 back() 真无效（如直接打开文章无历史），则 fallbackHref 整页跳转。
   * - 用 astro:page-load 初始化，避免重复绑定（每次导航后重新查询当前页的返回链接）。
   * 不影响浏览器原生后退/前进按钮、文章末尾"下一篇文章"导航。
   */
  function initBackNav() {
    const link = document.querySelector('[data-back-nav]') as HTMLAnchorElement | null;
    if (!link) return;

    // 避免同一链接重复绑定（astro:page-load 每次导航后都会查询）
    if (link.dataset.backNavBound === 'true') return;
    link.dataset.backNavBound = 'true';

    const fallbackHref = link.getAttribute('data-back-href') || '/';

    link.addEventListener('click', (e: MouseEvent) => {
      // 中键/右键/Ctrl(Cmd)+点击/Shift+点击等走原生行为（新标签页等）
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

      e.preventDefault();

      // 判断是否有可回退的历史记录（标签页有历史即可 back）
      const hasHistory = window.history.length > 1;

      if (!hasHistory) {
        // 无历史（如直接打开文章标签页）：安全回退首页
        window.location.href = fallbackHref;
        return;
      }

      // 有历史：history.back() 恢复来源页面。
      // ClientRouter 下 back() 触发 popstate → 站内页面切换，不整页卸载。
      // 注：persist 的 Header 中的返回链接会随导航更新 data-back-nav-bound 标记，
      // 但此处 dataset 标记在 persist 跨页面时可能残留——initBackNav 每次都会
      // 重新查询当前页的 [data-back-nav]，新页面的链接是新的 DOM（非 persist），无影响。
      history.back();
    });
  }

  // astro:page-load：每次页面加载后触发（含 ClientRouter 导航后）。
  document.addEventListener('astro:page-load', initBackNav);
</script>

<style>
  /* 三栏布局容器 */
  .article-layout {
    display: grid;
    grid-template-columns:
      minmax(180px, 220px)
      minmax(0, 1fr)
      minmax(180px, 240px);
    gap: var(--space-xl, 32px);
    max-width: var(--width-content, 72rem);
    margin-inline: auto;
    padding-inline: var(--space-lg, 24px);
    padding-top: var(--space-xl, 32px);
    align-items: start;
  }

  /* 左栏：sticky 定位，滚动时跟随 */
  .article-layout__left {
    position: sticky;
    top: calc(var(--height-header, 4rem) + var(--space-lg, 24px));
    max-height: calc(100vh - var(--height-header, 4rem) - var(--space-xl, 32px));
    overflow-y: auto;
  }

  /* 中栏正文宽度限制 */
  .article-layout__main {
    min-width: 0;
    max-width: 720px;
    margin-inline: auto;
  }

  /* 右栏：sticky 定位 */
  .article-layout__right {
    position: sticky;
    top: calc(var(--height-header, 4rem) + var(--space-lg, 24px));
    max-height: calc(100vh - var(--height-header, 4rem) - var(--space-xl, 32px));
    overflow-y: auto;
  }

  /* 桌面端隐藏移动端元信息 */
  .article-head__mobile-meta {
    display: none;
  }

  /* 面包屑 */
  .article-back {
    padding-bottom: var(--space-md, 16px);
    display: flex;
    align-items: center;
    gap: var(--space-sm, 12px);
  }

  .article-back__link {
    font-size: var(--fs-sm, 14px);
    color: var(--color-text-muted, #767289);
    text-decoration: none;
  }

  .article-back__link:hover {
    color: var(--color-brand, #6d4aff);
  }

  .article-back__demo-tag {
    font-size: var(--fs-xs, 12px);
    padding: var(--space-2xs, 4px) var(--space-sm, 12px);
    background-color: #fef3c7;
    color: #92400e;
    border-radius: var(--radius-sm, 4px);
    font-weight: var(--fw-medium, 500);
  }

  /* 文章头部：标题 → 发布时间 → 摘要 → 标签 → 横线（border-bottom） */
  .article-head {
    padding-bottom: var(--space-xl, 32px);
    border-bottom: 1px solid var(--color-border, #e7e4f2);
    margin-bottom: var(--space-2xl, 48px);
  }

  .article-head__title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: 2.25rem; /* 36px — 桌面端文章大标题 */
    font-weight: var(--fw-bold, 700);
    line-height: var(--lh-tight, 1.2);
    color: var(--color-heading, #2b2640);
    letter-spacing: -0.01em;
    text-wrap: balance; /* 平衡多行长度，避免末行只剩两三字 */
  }

  /* 发布时间：标题下方、摘要上方，12px 浅灰紫 */
  .article-head__published {
    display: block;
    margin-top: var(--space-sm, 12px);
    font-size: var(--fs-xs, 12px);
    color: var(--color-text-muted, #767289);
  }

  .article-head__summary {
    margin-top: var(--space-sm, 12px);
    font-size: 14px; /* 文章摘要字号，可手动调整 — 原 13px → 14px */
    font-style: italic; /* 摘要斜体，仅作用于文章详情页摘要 */
    color: var(--color-text-muted, #767289);
    line-height: 1.6;
    font-family: var(--font-serif, Georgia, serif);
  }

  /* 标签：摘要之后、横线之前，可点击跳转主题合集 */
  .article-head__tags {
    margin-top: var(--space-lg, 24px);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs, 8px);
  }

  .article-head__tag {
    font-size: var(--fs-xs, 12px);
    padding: var(--space-2xs, 4px) var(--space-sm, 12px);
    background-color: var(--color-brand-soft, #efeaff);
    color: var(--color-brand-strong, #5a36f0);
    border-radius: var(--radius-pill, 999px);
    text-decoration: none;
    border: 1px solid var(--color-brand-border, #d9ccff);
    transition: background-color var(--transition-fast, 150ms ease);
  }

  .article-head__tag:hover {
    background-color: var(--color-brand-border, #d9ccff);
    color: var(--color-brand-strong, #5a36f0);
  }

  /* 右栏容器 */
  .article-aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl, 32px);
  }

  /* ────────────────────────────────────────
   * 响应式：平板（768–1023px）双栏
   * 中正文 + 右来源，左栏目录隐藏（头部元信息已统一在中栏）
   * ──────────────────────────────────────── */
  @media (max-width: 1023px) {
    .article-layout {
      grid-template-columns:
        minmax(0, 1fr)
        minmax(160px, 220px);
      gap: var(--space-lg, 24px);
    }

    .article-layout__left {
      display: none;
    }
  }

  /* ────────────────────────────────────────
   * 响应式：手机（<768px）单栏
   * 元信息在正文开头，来源回退到文末（GFM 默认渲染）
   * ──────────────────────────────────────── */
  @media (max-width: 767px) {
    .article-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding-inline: var(--space-md, 16px);
    }

    .article-layout__right {
      display: none;
    }

    .article-layout__main {
      max-width: 100%;
    }

    .article-head__title {
      font-size: 1.5rem; /* 24px — 移动端标题缩小 */
    }

    .article-head__summary {
      font-size: 14px; /* 文章摘要字号，可手动调整 — 移动端与桌面端保持一致 */
    }

    .article-head__published {
      font-size: var(--fs-xs, 12px);
    }
  }
</style>
