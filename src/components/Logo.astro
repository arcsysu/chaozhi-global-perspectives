---
/**
 * YatCC Logo 组件
 *
 * 说明：
 * - 使用 public/deep-purple.svg（正方形流线环带标志，viewBox 1024×1024）。
 * - 右侧由 Header 显示「超智全球视野」文字。
 * - 通过 withBase() 引用 public 静态资源，部署到子路径时自动生效。
 *
 * Props:
 * - size: 图标高度（px），默认 36
 * - label: 无障碍标签
 */
import { withBase } from '../utils/site';

interface Props {
  size?: number;
  label?: string;
}

const { size = 50, label = '超智全球视野标志' } = Astro.props;
const logoSrc = withBase('/deep-purple.svg');
// 正方形 Logo（1024×1024），固定占位宽度避免加载前后布局位移。
const LOGO_RATIO = 1;
---

<span
  class="logo"
  role="img"
  aria-label={label}
  style={`--logo-size: ${size}px; --logo-width: calc(${size}px * ${LOGO_RATIO})`}
>
  <img
    class="logo__img"
    src={logoSrc}
    alt={label}
    width="1024"
    height="1024"
    loading="eager"
    decoding="async"
    aria-hidden="true"
  />
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 固定宽高：无论图片是否加载完成，容器都保持固定尺寸，
     * 避免图片加载失败时宽度塌缩导致品牌文字左移、加载成功时撑开导致右移。
     * flex: 0 0 禁止 Flexbox 压缩或拉伸。 */
    width: var(--logo-width);
    height: var(--logo-size);
    flex: 0 0 var(--logo-width);
  }

  /* 正方形 Logo 按高度等比缩放 */
  .logo__img {
    height: var(--logo-size);
    width: auto;
    display: block;
    object-fit: contain;
  }
</style>
