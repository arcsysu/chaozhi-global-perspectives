---
/**
 * YatCC Logo 占位组件
 *
 * 说明：
 * - YatCC 原始 Logo（紫色龙形 + YatCC 字标）尚未获取，本阶段使用简洁的
 *   "Y" 字母图标占位，未来获取正式 PNG/SVG 后直接替换本组件内部实现即可，
 *   Header 结构与调用方式不受影响。
 * - 不自行绘制复杂 Logo，不使用旧 Demo 中的假标志。
 * - 当前为纯 CSS / 内联 SVG 实现，无外部资源依赖。
 *
 * Props:
 * - size: 图标尺寸（px），默认 36
 * - label: 无障碍标签
 */
interface Props {
  size?: number;
  label?: string;
}

const { size = 36, label = 'YatCC' } = Astro.props;
---

<span class="logo" role="img" aria-label={label} style={`--logo-size: ${size}px`}>
  <span class="logo__mark" aria-hidden="true">Y</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--logo-size);
    height: var(--logo-size);
    flex-shrink: 0;
  }

  .logo__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-md);
    background: linear-gradient(
      135deg,
      var(--color-brand) 0%,
      var(--color-brand-strong) 100%
    );
    color: var(--color-text-invert);
    font-family: var(--font-sans);
    font-weight: var(--fw-bold);
    font-size: calc(var(--logo-size) * 0.55);
    line-height: 1;
    letter-spacing: -0.02em;
    box-shadow: 0 1px 3px rgba(var(--color-brand-rgb), 0.3);
  }
</style>
