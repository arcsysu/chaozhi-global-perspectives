---
/**
 * YatCC Logo 组件
 *
 * 说明：
 * - 从原始 yatcc-logo.png 中提取上方的紫粉渐变龙形图案（去除下方 DeepSeek /
 *   NSCC / StarLight 等文字），生成透明背景的独立 Logo（public/yatcc-dragon.png）。
 * - 本组件渲染该龙形图案，右侧由 Header 显示"超智全球视野"文字。
 * - 通过 withBase() 引用 public 静态资源，部署到子路径时自动生效。
 *
 * Props:
 * - size: 图标高度（px），默认 36
 * - label: 无障碍标签
 */
import { withBase } from '../utils/site';

interface Props {
  size?: number;
  label?: string;
}

const { size = 50, label = 'YatCC 龙形标志' } = Astro.props;
const logoSrc = withBase('/yatcc-logo.png');
---

<span class="logo" role="img" aria-label={label} style={`--logo-size: ${size}px`}>
  <img
    class="logo__img"
    src={logoSrc}
    alt={label}
    width="600"
    height="600"
    loading="eager"
    decoding="async"
    aria-hidden="true"
  />
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--logo-size);
    flex-shrink: 0;
  }

  /* 龙形图案按高度等比缩放，宽度自动跟随（原图 587×427，宽高比约 1.376） */
  .logo__img {
    height: var(--logo-size);
    width: auto;
    /* 仅在深色背景上显示时保证对比度；龙形本身为紫粉渐变，无需额外滤镜 */
    display: block;
    object-fit: contain;
  }
</style>
