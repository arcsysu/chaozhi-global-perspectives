---
/**
 * 基础 Footer
 *
 * 展示版权、团队、宣传语与简要导航补充。
 * 不编造统计数据，仅呈现已确定的品牌信息。
 */
import { site } from '../utils/site';
import { navItems, withBase } from '../utils/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <p class="footer__name">{site.name}</p>
      <p class="footer__slogan">{site.slogan}</p>
      <p class="footer__team">
        {site.team} · {site.direction}
      </p>
    </div>

    <nav class="footer__nav" aria-label="页脚导航">
      <ul role="list" class="footer__nav-list">
        {
          navItems.map((item) => (
            <li>
              <a href={withBase(item.path)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>© {year} {site.team} 团队 · {site.name}</p>
      <p class="footer__note">HPC + AI for Science 前沿观察计划</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-4xl);
    background-color: var(--color-surface-alt);
    border-top: 1px solid var(--color-border);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xl);
    padding-block: var(--space-2xl);
  }

  .footer__name {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
    color: var(--color-heading);
  }

  .footer__slogan {
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
    margin-top: var(--space-2xs);
  }

  .footer__team {
    color: var(--color-brand);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    margin-top: var(--space-xs);
  }

  .footer__nav-list {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-lg);
    row-gap: var(--space-sm);
  }

  .footer__nav-list a {
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
    transition: color var(--transition-fast);
  }

  .footer__nav-list a:hover {
    color: var(--color-brand);
  }

  .footer__bottom {
    border-top: 1px solid var(--color-border);
  }

  .footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-block: var(--space-md);
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }

  .footer__note {
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .footer__inner {
      flex-direction: column;
      gap: var(--space-lg);
    }
    .footer__bottom-inner {
      flex-direction: column;
      gap: var(--space-2xs);
    }
  }
</style>
