---
/**
 * 文章自动章节目录 (ArticleTOC)
 *
 * 从 render() 返回的 headings 数据自动生成目录。
 * 仅显示 h2、h3（depth 2、3），不强制短文章显示。
 *
 * 功能：
 * - 点击跳转对应章节（利用 Astro 自动生成的 heading id 锚点）。
 * - 滚动时高亮当前章节（IntersectionObserver）。
 * - 锚点跳转时偏移，避免被固定阅读栏遮挡（CSS scroll-margin-top）。
 *
 * 数据来源：render(entry).headings，结构为 { depth, slug, text }[]。
 */
export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

// 仅保留 h2(depth=2) 和 h3(depth=3)
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  tocHeadings.length >= 3 && (
    <nav class="article-toc" aria-label="章节目录">
      <h2 class="article-toc__title">目录</h2>
      <ul class="article-toc__list" id="article-toc-list">
        {tocHeadings.map((h) => (
          <li
            class:list={['article-toc__item', { 'article-toc__item--h3': h.depth === 3 }]}
          >
            <a
              href={`#${h.slug}`}
              class="article-toc__link"
              data-toc-slug={h.slug}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  // 滚动高亮当前章节（IntersectionObserver，无依赖）
  //
  // ClientRouter 兼容性：原脚本在首次加载时执行一次，导航到另一篇文章时
  // IntersectionObserver 仍观察旧标题元素（已分离），新文章的 TOC 不高亮。
  // 现用 astro:page-load 在每次进入文章页时重新初始化，并在离开时断开旧 observer。

  let tocObserver: IntersectionObserver | null = null;

  function initArticleTOC(): void {
    // 先断开上一轮 observer（离开文章页时 astro:before-swap 已断开，此处冗余兜底）
    tocObserver?.disconnect();
    tocObserver = null;

    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.article-toc__link');
    if (tocLinks.length === 0) return; // 非文章页或无目录

    const headingMap = new Map<string, HTMLAnchorElement>();
    tocLinks.forEach((link) => {
      const slug = link.dataset.tocSlug;
      if (slug) headingMap.set(slug, link);
    });

    // 观察所有正文标题元素
    const headingsToObserve = Array.from(headingMap.keys())
      .map((slug) => document.getElementById(slug))
      .filter((el): el is HTMLElement => el !== null);

    if (headingsToObserve.length === 0) return;

    let activeLink: HTMLAnchorElement | null = null;

    const observer = new IntersectionObserver(
      (entries) => {
        // 找到最靠近视口顶部的可见标题
        let topMost: { el: HTMLElement; top: number } | null = null;
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const top = entry.boundingClientRect.top;
            if (!topMost || top < topMost.top) {
              topMost = { el: entry.target as HTMLElement, top };
            }
          }
        }
        if (topMost) {
          const slug = topMost.el.id;
          const link = headingMap.get(slug);
          if (link && link !== activeLink) {
            activeLink?.classList.remove('is-active');
            link.classList.add('is-active');
            activeLink = link;
          }
        }
      },
      {
        // 根区域偏移：考虑固定阅读栏高度（约 80px）
        rootMargin: '-100px 0px -70% 0px',
        threshold: 0,
      },
    );

    headingsToObserve.forEach((el) => observer.observe(el));
    tocObserver = observer;
  }

  // astro:before-swap：离开文章页前断开 observer，避免引用已分离 DOM。
  document.addEventListener('astro:before-swap', () => {
    tocObserver?.disconnect();
    tocObserver = null;
  });

  // astro:page-load：每次页面加载后初始化（含 ClientRouter 导航后进入文章页）。
  document.addEventListener('astro:page-load', initArticleTOC);

  // 首次加载兜底（astro:page-load 在 ClientRouter 下会触发，此处兼容 SSR 直达）
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArticleTOC, { once: true });
  } else {
    initArticleTOC();
  }
</script>

<style>
  .article-toc {
    padding-top: var(--space-md);
  }

  /* 文章目录字号，可手动调整 */
  .article-toc__title {
    font-size: 13px; /* 目录标题，原 12px(var(--fs-xs)) → 13px */
    font-weight: var(--fw-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-sm);
  }

  .article-toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--color-border);
  }

  .article-toc__item {
    margin: 0;
  }

  .article-toc__item--h3 {
    padding-left: var(--space-md);
  }

  .article-toc__link {
    display: block;
    padding: var(--space-2xs) var(--space-sm);
    font-size: 14px; /* 目录条目(h2)，原 12px(var(--fs-xs)) → 14px */
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    margin-left: -2px;
    transition: color var(--transition-fast);
  }

  /* h3 子条目略小于 h2，保持层级区分 */
  .article-toc__item--h3 .article-toc__link {
    font-size: 13px; /* 目录子条目(h3)，比 h2 小 1px */
  }

  .article-toc__link:hover {
    color: var(--color-brand);
  }

  .article-toc__link.is-active {
    color: var(--color-brand);
    font-weight: var(--fw-medium);
    border-left-color: var(--color-brand);
  }
</style>
