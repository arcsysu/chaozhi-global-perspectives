  body[data-header-scrolled='true'] #site-header[data-home='true'] .header__brief {
    color: var(--home-header-text-muted);
  }

  body[data-header-scrolled='true'] #site-header[data-home='true'] .header__nav-link {
    color: var(--home-header-text-muted);
  }

  body[data-header-scrolled='true'] #site-header[data-home='true'] .header__nav-link:hover,
  body[data-header-scrolled='true'] #site-header[data-home='true'] .header__nav-link.is-active {
