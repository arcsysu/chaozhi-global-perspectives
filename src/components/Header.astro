  /* 响应式：≤768px 切换为移动导航
   * 移动端：页眉贴顶 top:0，近屏宽，仅保留少量左右边距。
   */
  @media (max-width: 768px) {
    .header {
      top: 0;
      margin-top: 0;
      margin-inline: var(--space-xs, 8px);
      max-width: none;
      border-radius: var(--radius-md, 8px);
    }

