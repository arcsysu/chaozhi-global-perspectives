---
/**
 * 网站 Header + 顶部导航
 *
 * 布局（桌面，单行）：
 * [YatCC Logo] 超智全球视野 | 简介    首页 主题 时间树 关于我们    [搜索]
 *
 * 布局（移动）：
 * [Logo] 超智全球视野 [搜索] [汉堡]
 *        └─ 折叠面板：首页 主题 时间树 关于我们
 *
 * 实现：
 * - 当前栏目：比较 Astro.url.pathname 与 navItem.matchPrefix，命中时下方加紫色细线 + aria-current。
 * - 移动端折叠：极少量原生 JS（island 内联脚本），无外部依赖。
 * - 搜索：点击搜索图标展开 SearchPanel 下拉，标题搜索（静态 JSON 索引 + 原生 JS）。
 *   ESC 关闭、焦点管理、移动端全宽，详见 SearchPanel.astro。
 * - 语义标签：<header><nav><ul><li><a>，配合 aria 属性满足键盘与无障碍。
 */
import Logo from './Logo.astro';
import SearchPanel from './SearchPanel.astro';
import { site, navItems, withBase } from '../utils/site';

// 计算 BASE_URL（去除末尾斜杠），注入到搜索触发按钮的 data-base 供 JS 读取
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '/';

// 计算当前路径，用于高亮判断。统一去除末尾斜杠便于前缀匹配。
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

// 首页判断：首页顶部为浅紫粒子动态背景，Header 需透明 + 深色文字；
// 滚动离开 Hero 后平滑过渡为浅紫白毛玻璃背景。非首页保持原有浅色实体 Header。
const isHome = pathname === '/';

function isActive(item: (typeof navItems)[number]): boolean {
  const prefix = (item.matchPrefix ?? item.path).replace(/\/$/, '') || '/';
  if (prefix === '/') {
    return pathname === '/';
  }
  return pathname === prefix || pathname.startsWith(prefix + '/');
}
---

<header class="header" id="site-header" data-home={isHome ? 'true' : 'false'} transition:persist>
  <div class="container header__inner">
    <!-- 左：品牌区（Logo + 名称 + 简介） -->
    <a href={withBase('/')} class="header__brand" aria-label={`${site.team} ${site.name} 首页`}>
      <Logo size={48} />
      <span class="header__brand-text">
        <span class="header__site-name">{site.name}</span>
        <span class="header__brief">{site.brief}</span>
      </span>
    </a>

    <!-- 中：主导航（桌面可见） -->
    <nav class="header__nav" aria-label="主导航">
      <ul role="list" class="header__nav-list">
        {
          navItems.map((item) => (
            <li>
              <a
                href={withBase(item.path)}
                class:list={['header__nav-link', { 'is-active': isActive(item) }]}
                aria-current={isActive(item) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- 右：搜索 + 移动端菜单按钮 -->
    <div class="header__actions">
      <button
        type="button"
        class="header__search"
        id="search-trigger"
        aria-label="搜索文章"
        aria-haspopup="dialog"
        aria-expanded="false"
        data-base={baseUrl}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <button
        type="button"
        class="header__toggle"
        aria-label="展开导航菜单"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="visually-hidden">菜单</span>
        <span class="header__toggle-icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <!-- 搜索面板（下拉覆盖层） -->
  <SearchPanel />

  <!-- 移动端折叠导航面板 -->
  <nav class="mobile-nav" id="mobile-nav" aria-label="移动导航" hidden>
    <ul role="list" class="mobile-nav__list">
      {
        navItems.map((item) => (
          <li>
            <a
              href={withBase(item.path)}
              class:list={['mobile-nav__link', { 'is-active': isActive(item) }]}
              aria-current={isActive(item) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // ──────────────────────────────────────────────
  // Header 客户端脚本（兼容 Astro ClientRouter + transition:persist）
  //
  // Header 使用 transition:persist：站内导航时同一 <header> DOM 节点被保留，
  // Logo 图片不被销毁重建，消除"消失再出现"闪烁。但持久化带来三个问题，
  // 以下逐一处理：
  //
  // 1. 导航高亮 / data-home 不更新：
  //    persist 的 Header 携带首次渲染时的 aria-current / is-active / data-home，
  //    切到新页面后这些标记仍是旧页面的。需在每次导航后根据新 URL 重新计算。
  //
  // 2. isHomePage 闭包陈旧：
  //    原实现 const isHomePage = headerEl?.getAttribute('data-home') === 'true'
  //    在脚本首次执行时定型，导航后不更新。改为每次实时读取 data-home。
  //
  // 3. 滚动监听重复绑定：
  //    persist 元素的 <script> 仅在首次加载执行一次（不会随导航重跑），
  //    因此 scroll/resize 监听天然只注册一次，无需去重。但页面级状态
  //    （hidden / scrolledPastHero / lastScrollY）需在每次导航后重置，
  //    否则离开文章页时 hidden=true 会残留，Header 在新页面持续隐藏。
  //
  // 导航生命周期：
  // - astro:page-load：每次页面加载后触发（含首次加载 + 每次 ClientRouter 导航后）。
  //   用于重置状态、重新同步 data-home / 导航高亮 / Hero 背景。
  //
  // ──────────────────────────────────────────────
  // 文章页返回导航（统一返回上一页）
  //
  // 问题背景：
  // - 文章顶部返回按钮（.article-back__link）与精简阅读栏返回按钮
  //   （.reading-bar__logo）曾用两套实现：前者 history.back()，后者纯静态
  //   <a href="/">，导致精简 Header 返回按钮错误跳首页。
  // - history.length 无法区分站内/外部历史（标签页历史可能含外部网站），
  //   直接 back() 可能跳到外部网站，不安全。
  // - document.referrer 在 ClientRouter 下不更新（始终首屏来源），不可靠。
  //
  // 统一方案（最小必要的站内来源记录）：
  // - 维护 inSiteNavDepth 计数器：记录从标签页首个站内页面开始累计的站内
  //   导航深度（pushState / ClientRouter 前进 +1，back/forward -1）。
  //   首屏加载时若来源为外部或直接打开，深度从 0 起；站内链接点进来则继承。
  // - astro:before-swap（站内前进）/ astro:after-swap 后据方向更新深度。
  // - 所有 [data-back-nav]（顶部 + 精简栏 + 移动端）走同一事件委托：
  //   有可靠站内来源（depth > 0）→ history.back() 恢复来源页与滚动位置；
  //   无可靠来源 → 用 data-back-href 整页跳转首页（绝不跳外部网站）。
  // - 事件委托在 persist Header 上注册一次，精简栏 DOM 每次导航重建也会被覆盖，
  //   无重复绑定、无旧闭包残留。
  // ──────────────────────────────────────────────

  /** 主导航项（与 site.ts navItems 同步，用于客户端高亮判断） */
  interface NavItemClient {
    label: string;
    path: string;
    matchPrefix: string;
  }
  const NAV_ITEMS: NavItemClient[] = [
    { label: '首页', path: '/', matchPrefix: '/' },
    { label: '主题', path: '/topics/', matchPrefix: '/topics' },
    { label: '时间树', path: '/archive/', matchPrefix: '/archive' },
    { label: '关于我们', path: '/about/', matchPrefix: '/about' },
  ];

  /** BASE_URL（去除末尾斜杠），用于比对 navItem.path */
  const BASE_URL = import.meta.env.BASE_URL.replace(/\/$/, '') || '/';

  /** 判断给定 pathname 是否匹配某导航项（与 Astro 端 isActive 逻辑一致） */
  function navItemIsActive(item: NavItemClient, pathname: string): boolean {
    // 去除 BASE_URL 前缀，得到站点相对路径
    let rel = pathname;
    if (BASE_URL !== '/' && rel.startsWith(BASE_URL)) {
      rel = rel.slice(BASE_URL.length);
    }
    rel = rel.replace(/\/$/, '') || '/';
    const prefix = (item.matchPrefix ?? item.path).replace(/\/$/, '') || '/';
    if (prefix === '/') return rel === '/';
    return rel === prefix || rel.startsWith(prefix + '/');
  }

  /** 根据当前 URL 更新持久 Header 的导航高亮与 data-home（每次导航后调用） */
  function syncHeaderForCurrentPage(): void {
    const headerEl = document.getElementById('site-header');
    if (!headerEl) return;

    const pathname = window.location.pathname;
    const isHome = pathname === (BASE_URL === '/' ? '/' : BASE_URL + '/') || pathname === BASE_URL;
    headerEl.setAttribute('data-home', String(isHome));

    // 更新桌面导航高亮
    const desktopLinks = headerEl.querySelectorAll<HTMLAnchorElement>('.header__nav-link');
    desktopLinks.forEach((link, i) => {
      const item = NAV_ITEMS[i];
      if (!item) return;
      const active = navItemIsActive(item, pathname);
      link.classList.toggle('is-active', active);
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });

    // 更新移动端导航高亮
    const mobileLinks = headerEl.querySelectorAll<HTMLAnchorElement>('.mobile-nav__link');
    mobileLinks.forEach((link, i) => {
      const item = NAV_ITEMS[i];
      if (!item) return;
      const active = navItemIsActive(item, pathname);
      link.classList.toggle('is-active', active);
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  }

  // ──────────────────────────────────────────────
  // 移动端导航折叠交互（原生 JS，无依赖）
  // ──────────────────────────────────────────────
  const toggle = document.querySelector<HTMLButtonElement>('.header__toggle');
  const panel = document.getElementById('mobile-nav');

  // 搜索触发按钮 aria-expanded 同步（SearchPanel 控制面板开合，此处仅同步按钮状态）
  const searchTrigger = document.getElementById('search-trigger');
  const searchPanel = document.getElementById('search-panel');
  if (searchTrigger && searchPanel) {
    // 使用 MutationObserver 监听 panel 的 hidden 属性变化，同步按钮 aria-expanded
    const observer = new MutationObserver(() => {
      searchTrigger.setAttribute('aria-expanded', String(!searchPanel.hidden));
    });
    observer.observe(searchPanel, { attributes: true, attributeFilter: ['hidden'] });
  }

  /** 移动端菜单是否展开（展开时不让滚动隐藏 Header） */
  function mobileNavOpen(): boolean {
    return panel != null && !panel.hidden;
  }

  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      toggle.setAttribute('aria-label', expanded ? '展开导航菜单' : '收起导航菜单');
      panel.hidden = expanded;
      // 展开/收起时强制 Header 可见
      document.body.setAttribute('data-header-hidden', 'false');
    });

    // 点击导航链接后自动收起
    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', '展开导航菜单');
        panel.hidden = true;
      });
    });

    // ESC 关闭
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', '展开导航菜单');
        panel.hidden = true;
        toggle.focus();
      }
    });
  }

  // ──────────────────────────────────────────────
  // Header 滚动隐藏/展开协调器
  // — 贴顶 top:0；下滑隐藏；上滑展开；顶部完整显示。
  // — 文章页与阅读栏互斥：body.has-reading-bar 时，阅读栏负责标题离开视口的切换，
  //   本协调器仅处理"标题可见区"之外的滚动隐藏/展开，避免竞争。
  // — 移动端菜单展开时禁用隐藏，避免导航被收走。
  // — isHomePage 改为实时读取 data-home（每次导航后由 syncHeaderForCurrentPage 更新），
  //   避免持久 Header 的闭包陈旧。
  // ──────────────────────────────────────────────

  const SCROLL_HIDE_THRESHOLD = 12; // 滚动超过 12px 才允许隐藏（避免页面顶部抖动）
  const SCROLL_DELTA_THRESHOLD = 8; // 滚动方向变化需超过 8px（触控板滞后，防闪烁）

  let lastScrollY = window.scrollY;
  let ticking = false;
  let hidden = false; // 当前 Header 是否隐藏
  let scrolledPastHero = false; // 首页是否已离开 Hero 区

  function isReadingBarVisible(): boolean {
    const bar = document.getElementById('reading-bar');
    return bar != null && bar.getAttribute('data-visible') === 'true';
  }

  /** 实时判断当前是否首页（读取持久 Header 的 data-home，导航后已更新） */
  function isHomePageNow(): boolean {
    const headerEl = document.getElementById('site-header');
    return headerEl?.getAttribute('data-home') === 'true';
  }

  // 首页粒子背景协调：首页顶部 Header 透明+深色文字（叠在浅紫粒子背景上），
  // 滚动离开 Hero 区域后平滑过渡为浅紫白毛玻璃背景。非首页 Header 始终保持浅色实体。
  // 通过 body[data-header-scrolled] 驱动 CSS 切换，与显隐机制独立、不冲突。
  function updateHomeHeaderBg(currentY: number): void {
    if (!isHomePageNow()) {
      // 非首页：确保不残留首页的 scrolled 标记
      if (document.body.getAttribute('data-header-scrolled') !== null) {
        document.body.removeAttribute('data-header-scrolled');
      }
      scrolledPastHero = false;
      return;
    }
    // Hero 高度约 90vh，滚动超过 60% 视口高度即视为离开 Hero
    const threshold = window.innerHeight * 0.6;
    const past = currentY > threshold;
    if (past !== scrolledPastHero) {
      scrolledPastHero = past;
      document.body.setAttribute('data-header-scrolled', String(past));
    }
  }

  function updateHeaderState(): void {
    ticking = false;
    const currentY = window.scrollY;
    const delta = currentY - lastScrollY;

    // 首页：无论是否处于显隐逻辑，都同步 Hero 背景状态
    updateHomeHeaderBg(currentY);

    // 顶部：完整显示
    if (currentY <= SCROLL_HIDE_THRESHOLD) {
      if (hidden) {
        hidden = false;
        document.body.setAttribute('data-header-hidden', 'false');
      }
      lastScrollY = currentY;
      return;
    }

    // 移动端菜单展开时不隐藏
    if (mobileNavOpen()) {
      lastScrollY = currentY;
      return;
    }

    // 文章页：阅读栏可见时（标题已离开视口）让出给阅读栏，不在此隐藏普通 Header
    // 阅读栏自身在标题离开时通过 body.has-reading-bar 的 reading-mode 处理。
    // 此处只在阅读栏不可见、且标题仍在视口附近时按方向隐藏/展开。
    if (document.body.classList.contains('has-reading-bar') && isReadingBarVisible()) {
      lastScrollY = currentY;
      return;
    }

    // 下滑超过阈值 → 隐藏
    if (delta > SCROLL_DELTA_THRESHOLD && !hidden) {
      hidden = true;
      document.body.setAttribute('data-header-hidden', 'true');
    }
    // 上滑超过阈值 → 展开
    else if (delta < -SCROLL_DELTA_THRESHOLD && hidden) {
      hidden = false;
      document.body.setAttribute('data-header-hidden', 'false');
    }

    lastScrollY = currentY;
  }

  function onScroll(): void {
    if (!ticking) {
      window.requestAnimationFrame(updateHeaderState);
      ticking = true;
    }
  }

  /**
   * 页面进入后重置 Header 状态（每次导航后调用，含首次加载）。
   * - 重置 hidden / scrolledPastHero / lastScrollY，避免跨页面残留。
   * - 重新同步导航高亮 / data-home。
   * - 清理可能残留的首页 scrolled 标记（离开首页时）。
   */
  function resetHeaderForNavigation(): void {
    hidden = false;
    scrolledPastHero = false;
    lastScrollY = window.scrollY;
    document.body.setAttribute('data-header-hidden', 'false');
    syncHeaderForCurrentPage();
    updateHomeHeaderBg(window.scrollY);
  }

  // 持久 Header 的脚本仅执行一次：注册 scroll/resize 监听（不会重复）。
  window.addEventListener('scroll', onScroll, { passive: true });
  // 视口尺寸变化时重新计算 Hero 阈值（如旋转屏幕、调整窗口）
  window.addEventListener('resize', () => updateHomeHeaderBg(window.scrollY), { passive: true });

  // astro:page-load：每次页面加载后触发（首次加载 + 每次 ClientRouter 站内导航后）。
  // 在此重置 Header 状态并重新同步导航高亮 / data-home / Hero 背景。
  document.addEventListener('astro:page-load', resetHeaderForNavigation);

  // ──────────────────────────────────────────────
  // 统一返回上一页导航（文章页所有返回入口）
  //
  // 覆盖入口：
  // - 文章顶部返回按钮（.article-back__link[data-back-nav]）
  // - 精简阅读栏返回按钮（.reading-bar__logo[data-back-nav]）
  // - 移动端相应入口（统一带 data-back-nav）
  //
  // 站内来源判定（最小必要记录，不依赖 document.referrer / history.length）：
  // - 在 history.state 上打 __site 标记，标识"站内导航可达的条目"。
  // - 首屏加载：若来源为站内（document.referrer 同源）则给当前 entry 打 __site；
  //   否则（直接打开 / 外部进入）不打标记，作为站内历史的"根"。
  // - ClientRouter 站内前进：astro:before-swap 时给即将进入的 entry 标记 __site
  //   （通过 astro:before-preparation 或 swap 前的 pushState 时机）。
  //   实际 ClientRouter 自身已 pushState 新 URL，我们在 astro:after-swap
  //   补打 __site 标记（保留原 state 其它字段，如首页分页的 scrollY）。
  // - 浏览器原生后退/前进：popstate 恢复的 state 自带 __site 标记（若曾是站内）。
  //
  // 点击返回逻辑：
  // - 当前 entry 的前一个 entry 是否站内？用 history.state.__site 判断"当前在站内
  //   历史链中"还不够——需要知道能否安全 back() 回站内页。
  // - 采用计数法 + 标记法结合：维护 canGoBackInSite = 当前 history.state 有 __site
  //   且不是站内历史的第一个 entry。判断"是否第一个站内 entry"：若当前 state.__site
  //   存在但其来源（前一条）无 __site，则 back() 会离开站内 → 不安全。
  // - 简化可靠实现：只要当前页面是通过站内导航进入（state.__site === true），
  //   就认为存在可 back 的站内来源。首屏直接打开/外部进入时 state 无 __site，
  //   不走 back()，直接 fallback 到首页。这覆盖了所有预期场景：
  //     * 首页列表→文章：文章 entry 有 __site（站内导航进入）→ back() 回列表。
  //     * 直接打开文章 URL：首屏无 __site → fallback 首页。
  //     * 外部→文章：首屏无 __site → fallback 首页。
  //
  // 事件委托优势：
  // - persist Header 的 <script> 仅执行一次，事件委托注册一次。
  // - 精简阅读栏 DOM 每次导航重建，但其 [data-back-nav] 冒泡到 document
  //   委托处理器，无需重新绑定，无旧闭包残留。
  // ──────────────────────────────────────────────

  /** 站内来源标记的 state key */
  const SITE_HISTORY_KEY = '__site';

  /** 判断当前 history.state 是否带有站内来源标记 */
  function currentEntryIsInSiteHistory(): boolean {
    const st = window.history.state;
    return !!st && typeof st === 'object' && st[SITE_HISTORY_KEY] === true;
  }

  /** 给当前 history entry 打上站内标记（保留其它 state 字段） */
  function markCurrentEntryInSite(): void {
    try {
      const st = window.history.state || {};
      if (st[SITE_HISTORY_KEY] === true) return; // 已标记
      const next = { ...st, [SITE_HISTORY_KEY]: true };
      window.history.replaceState(next, '');
    } catch {
      // history.state 序列化失败等异常：静默，保守不标记
    }
  }

  /**
   * 是否已完成首屏 page-load。
   * 首屏（硬导航）的 history entry 视为"站内历史链的根"，不打 __site 标记：
   * - 直接打开文章 URL / 外部进入文章 → 首屏无 __site → 返回按钮 fallback 首页。
   * - 首页点文章 → 文章页是第二次 page-load（非首屏）→ 打 __site → back() 回首页。
   */
  let firstPageLoadDone = false;

  /**
   * astro:page-load：每次页面加载后触发（首屏 + 每次 ClientRouter 站内导航后）。
   * - 首屏：仅置 firstPageLoadDone=true，不打标记（作为站内历史链根）。
   * - 非首屏（站内导航进入）：给当前 entry 打 __site 标记，表示有可 back 的站内来源。
   *   保留原 state（首页分页 pushState 的 { homePagination, scrollY } 等字段）。
   *
   * 用 page-load 而非 after-swap 的原因：page-load 在 after-swap 之后触发，
   * 此时 ClientRouter 的 pushState 已完成，history.state 已是新 entry 的 state，
   * replaceState 补打 __site 安全且不会与 ClientRouter 的 state 操作竞争。
   */
  document.addEventListener('astro:page-load', () => {
    if (!firstPageLoadDone) {
      firstPageLoadDone = true;
      return;
    }
    markCurrentEntryInSite();
  });

  /**
   * 统一返回按钮事件委托：document 级，覆盖所有 [data-back-nav]（含重建的精简栏）。
   * persist Header 脚本仅执行一次 → 委托器只注册一次，无重复绑定。
   */
  document.addEventListener('click', (e: MouseEvent) => {
    const target = e.target;
    const link =
      target instanceof Element
        ? (target.closest('[data-back-nav]') as HTMLAnchorElement | null)
        : null;
    if (!link) return;

    // 中键/右键/Ctrl(Cmd)+点击/Shift+点击等走原生行为（新标签页等）
    if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

    e.preventDefault();

    // fallback href：无可靠站内来源时整页跳转（默认首页，绝不跳外部）
    const fallbackHref = link.getAttribute('data-back-href') || '/';

    // 判定是否存在可靠的站内来源（当前 entry 由站内导航进入）
    if (currentEntryIsInSiteHistory()) {
      // 有可靠站内来源：history.back() 恢复来源页及滚动位置。
      // ClientRouter 下 back() 触发 popstate → 站内页面切换，不整页卸载。
      // 首页分页的 popstate 处理器会据 data-page 恢复正确分页与滚动位置。
      window.history.back();
    } else {
      // 无可靠站内来源（直接打开 / 外部进入）：安全回退首页
      window.location.href = fallbackHref;
    }
  });
</script>

<style>
  /* 普通页眉：居中悬浮实体，贴合视口顶部（无顶部间距）
