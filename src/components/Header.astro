  }

  .header__toggle-icon,
  .header__toggle-icon::before,
  .header__toggle-icon::after {
    display: block;
    width: 20px;
    height: 2px;
    background-color: currentColor;
    border-radius: 1px;
    transition: transform var(--transition-fast);
  }

  .header__toggle-icon {
