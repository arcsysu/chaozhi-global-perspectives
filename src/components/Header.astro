  body[data-header-scrolled='true'] #site-header[data-home='true'] .header__toggle {
    color: var(--home-header-text);
  }

  /* 下滑隐藏：body[data-header-hidden='true'] 时上滑收回视口外 */
  body[data-header-hidden='true'] #site-header {
    transform: translateY(-110%);
    opacity: 0;
    pointer-events: none;
  }

  /* 文章页：页眉重新展开时延迟 150ms（等阅读栏收回），避免叠加闪烁 */
  body.has-reading-bar[data-header-hidden='false'] #site-header {
    transition-delay: 150ms;
  }

  .header__inner {
    display: flex;
