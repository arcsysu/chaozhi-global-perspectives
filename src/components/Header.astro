    border-radius: var(--radius-lg, 12px);
    box-shadow: var(--shadow-header-float, 0 2px 12px rgba(43, 38, 64, 0.06));
    transform: translateY(0);
    transition:
      transform var(--transition-base, 250ms) cubic-bezier(0.4, 0, 0.2, 1),
      opacity var(--transition-base, 250ms) ease,
      background-color var(--transition-base, 250ms) ease,
      border-color var(--transition-base, 250ms) ease,
      box-shadow var(--transition-base, 250ms) ease;
    will-change: transform;
  }

  /* ─── 首页 Header 背景与文字配色 ───────────────────────────
   * 首页顶部为浅紫粒子动态背景（#e8e8fd 底 + #5b0693 紫色粒子）：
   * - 未滚动（body[data-header-scrolled='false']，默认）：Header 透明，文字/图标深色，
   *   去掉边框与阴影，让粒子透出，避免在浅紫背景上出现白色实体条断层。
   * - 已滚动离开 Hero（body[data-header-scrolled='true']）：平滑过渡为浅紫白毛玻璃
   *   （rgba(255,255,255,0.7) + backdrop-filter blur），文字保持深色，保证对比度。
   * 非首页 #site-header[data-home='false'] 不命中以下规则，保持原浅色实体样式。
   */
  #site-header[data-home='true'] {
    --home-header-text: #2b2640;
    --home-header-text-muted: #4a4660;
  }

  /* 首页未滚动（Hero 区）：透明背景 + 深色文字，无边框无阴影 */
