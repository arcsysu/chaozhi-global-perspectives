---
/**
 * 网站 Header + 顶部导航
 *
 * 布局（桌面，单行）：
 * [YatCC Logo] 超智全球视野 | 简介    首页 主题 时间树 关于我们    [搜索]
 *
 * 布局（移动）：
 * [Logo] 超智全球视野 [搜索] [汉堡]
 *        └─ 折叠面板：首页 主题 时间树 关于我们
 *
 * 实现：
 * - 当前栏目：比较 Astro.url.pathname 与 navItem.matchPrefix，命中时下方加紫色细线 + aria-current。
 * - 移动端折叠：极少量原生 JS（island 内联脚本），无外部依赖。
 * - 搜索：点击搜索图标展开 SearchPanel 下拉，标题搜索（静态 JSON 索引 + 原生 JS）。
 *   ESC 关闭、焦点管理、移动端全宽，详见 SearchPanel.astro。
 * - 语义标签：<header><nav><ul><li><a>，配合 aria 属性满足键盘与无障碍。
 */
import Logo from './Logo.astro';
import SearchPanel from './SearchPanel.astro';
import { site, navItems, withBase } from '../utils/site';

// 计算 BASE_URL（去除末尾斜杠），注入到搜索触发按钮的 data-base 供 JS 读取
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '/';

// 计算当前路径，用于高亮判断。统一去除末尾斜杠便于前缀匹配。
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(item: (typeof navItems)[number]): boolean {
  const prefix = (item.matchPrefix ?? item.path).replace(/\/$/, '') || '/';
  if (prefix === '/') {
    return pathname === '/';
  }
  return pathname === prefix || pathname.startsWith(prefix + '/');
}
---

<header class="header" id="site-header">
  <div class="container header__inner">
    <!-- 左：品牌区（Logo + 名称 + 简介） -->
    <a href={withBase('/')} class="header__brand" aria-label={`${site.team} ${site.name} 首页`}>
      <Logo size={36} />
      <span class="header__brand-text">
        <span class="header__site-name">{site.name}</span>
        <span class="header__brief">{site.brief}</span>
      </span>
    </a>

    <!-- 中：主导航（桌面可见） -->
    <nav class="header__nav" aria-label="主导航">
      <ul role="list" class="header__nav-list">
        {
          navItems.map((item) => (
            <li>
              <a
                href={withBase(item.path)}
                class:list={['header__nav-link', { 'is-active': isActive(item) }]}
                aria-current={isActive(item) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- 右：搜索 + 移动端菜单按钮 -->
    <div class="header__actions">
      <button
        type="button"
        class="header__search"
        id="search-trigger"
        aria-label="搜索文章"
        aria-haspopup="dialog"
        aria-expanded="false"
        data-base={baseUrl}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <button
        type="button"
        class="header__toggle"
        aria-label="展开导航菜单"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="visually-hidden">菜单</span>
        <span class="header__toggle-icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <!-- 搜索面板（下拉覆盖层） -->
  <SearchPanel />

  <!-- 移动端折叠导航面板 -->
  <nav class="mobile-nav" id="mobile-nav" aria-label="移动导航" hidden>
    <ul role="list" class="mobile-nav__list">
      {
        navItems.map((item) => (
          <li>
            <a
              href={withBase(item.path)}
              class:list={['mobile-nav__link', { 'is-active': isActive(item) }]}
              aria-current={isActive(item) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // 移动端导航折叠交互（原生 JS，无依赖）
  const toggle = document.querySelector<HTMLButtonElement>('.header__toggle');
  const panel = document.getElementById('mobile-nav');

  // 搜索触发按钮 aria-expanded 同步（SearchPanel 控制面板开合，此处仅同步按钮状态）
  const searchTrigger = document.getElementById('search-trigger');
  const searchPanel = document.getElementById('search-panel');
  if (searchTrigger && searchPanel) {
    // 使用 MutationObserver 监听 panel 的 hidden 属性变化，同步按钮 aria-expanded
    const observer = new MutationObserver(() => {
      searchTrigger.setAttribute('aria-expanded', String(!searchPanel.hidden));
    });
    observer.observe(searchPanel, { attributes: true, attributeFilter: ['hidden'] });
  }

  /** 移动端菜单是否展开（展开时不让滚动隐藏 Header） */
  function mobileNavOpen(): boolean {
    return panel != null && !panel.hidden;
  }

  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      toggle.setAttribute('aria-label', expanded ? '展开导航菜单' : '收起导航菜单');
      panel.hidden = expanded;
      // 展开/收起时强制 Header 可见
      document.body.setAttribute('data-header-hidden', 'false');
    });

    // 点击导航链接后自动收起
    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', '展开导航菜单');
        panel.hidden = true;
      });
    });

    // ESC 关闭
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', '展开导航菜单');
        panel.hidden = true;
        toggle.focus();
      }
    });
  }

  // ──────────────────────────────────────────────
  // Header 滚动隐藏/展开协调器
  // — 贴顶 top:0；下滑隐藏；上滑展开；顶部完整显示。
  // — 文章页与阅读栏互斥：body.has-reading-bar 时，阅读栏负责标题离开视口的切换，
  //   本协调器仅处理"标题可见区"之外的滚动隐藏/展开，避免竞争。
  // — 移动端菜单展开时禁用隐藏，避免导航被收走。
  // ──────────────────────────────────────────────

  const SCROLL_HIDE_THRESHOLD = 12; // 滚动超过 12px 才允许隐藏（避免页面顶部抖动）
  const SCROLL_DELTA_THRESHOLD = 8; // 滚动方向变化需超过 8px（触控板滞后，防闪烁）

  let lastScrollY = window.scrollY;
  let ticking = false;
  let hidden = false; // 当前 Header 是否隐藏

  function isReadingBarVisible(): boolean {
    const bar = document.getElementById('reading-bar');
    return bar != null && bar.getAttribute('data-visible') === 'true';
  }

  function updateHeaderState(): void {
    ticking = false;
    const currentY = window.scrollY;
    const delta = currentY - lastScrollY;

    // 顶部：完整显示
    if (currentY <= SCROLL_HIDE_THRESHOLD) {
      if (hidden) {
        hidden = false;
        document.body.setAttribute('data-header-hidden', 'false');
      }
      lastScrollY = currentY;
      return;
    }

    // 移动端菜单展开时不隐藏
    if (mobileNavOpen()) {
      lastScrollY = currentY;
      return;
    }

    // 文章页：阅读栏可见时（标题已离开视口）让出给阅读栏，不在此隐藏普通 Header
    // 阅读栏自身在标题离开时通过 body.has-reading-bar 的 reading-mode 处理。
    // 此处只在阅读栏不可见、且标题仍在视口附近时按方向隐藏/展开。
    if (document.body.classList.contains('has-reading-bar') && isReadingBarVisible()) {
      lastScrollY = currentY;
      return;
    }

    // 下滑超过阈值 → 隐藏
    if (delta > SCROLL_DELTA_THRESHOLD && !hidden) {
      hidden = true;
      document.body.setAttribute('data-header-hidden', 'true');
    }
    // 上滑超过阈值 → 展开
    else if (delta < -SCROLL_DELTA_THRESHOLD && hidden) {
      hidden = false;
      document.body.setAttribute('data-header-hidden', 'false');
    }

    lastScrollY = currentY;
  }

  function onScroll(): void {
    if (!ticking) {
      window.requestAnimationFrame(updateHeaderState);
      ticking = true;
    }
  }

  // 初始化默认可见
  document.body.setAttribute('data-header-hidden', 'false');
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  /* 普通页眉：居中悬浮实体，贴合视口顶部（无顶部间距）
   * — position: sticky 吸顶 top:0；max-width 限制宽度居中；margin-inline 留侧边距。
   * — transform: translateY() 由 body[data-header-hidden] 驱动：下滑隐藏、上滑展开。
   * — 文章页（body.has-reading-bar）下，页眉显示（hidden→visible）延迟 150ms，
   *   等阅读栏先收回，避免两个栏同时叠加；隐藏（visible→hidden）不延迟。
   */
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    max-width: var(--width-content, 72rem);
    margin-inline: auto;
    margin-top: 0;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 12px);
    box-shadow: var(--shadow-header-float, 0 2px 12px rgba(43, 38, 64, 0.06));
    transform: translateY(0);
    transition:
      transform var(--transition-base, 250ms) cubic-bezier(0.4, 0, 0.2, 1),
      opacity var(--transition-base, 250ms) ease;
    will-change: transform;
  }

  /* 下滑隐藏：body[data-header-hidden='true'] 时上滑收回视口外 */
  body[data-header-hidden='true'] #site-header {
    transform: translateY(-110%);
    opacity: 0;
    pointer-events: none;
  }

  /* 文章页：页眉重新展开时延迟 150ms（等阅读栏收回），避免叠加闪烁 */
  body.has-reading-bar[data-header-hidden='false'] #site-header {
    transition-delay: 150ms;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: var(--height-header);
    padding-inline: var(--space-lg);
  }

  /* 品牌区 */
  .header__brand {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-shrink: 0;
  }

  .header__brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .header__site-name {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: var(--fw-semibold);
    color: var(--color-heading);
  }

  .header__brief {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* 主导航 */
  .header__nav {
    margin-inline: auto;
  }

  .header__nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  .header__nav-link {
    position: relative;
    display: inline-block;
    padding-block: var(--space-sm);
    color: var(--color-text);
    font-size: var(--fs-base);
    font-weight: var(--fw-medium);
    transition: color var(--transition-fast);
  }

  .header__nav-link:hover {
    color: var(--color-brand);
  }

  /* 当前栏目：下方紫色细线 */
  .header__nav-link.is-active {
    color: var(--color-brand);
  }

  .header__nav-link.is-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background-color: var(--color-nav-active);
    border-radius: 1px;
  }

  /* 操作区 */
  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-shrink: 0;
  }

  .header__search {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .header__search:hover {
    color: var(--color-brand);
    background-color: var(--color-brand-soft);
  }

  .header__search[aria-expanded='true'] {
    color: var(--color-brand);
    background-color: var(--color-brand-soft);
  }

  /* 汉堡按钮（仅移动端） */
  .header__toggle {
    display: none;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    color: var(--color-heading);
  }

  .header__toggle-icon,
  .header__toggle-icon::before,
  .header__toggle-icon::after {
    display: block;
    width: 20px;
    height: 2px;
    background-color: currentColor;
    border-radius: 1px;
    transition: transform var(--transition-fast);
  }

  .header__toggle-icon {
    position: relative;
  }

  .header__toggle-icon::before,
  .header__toggle-icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .header__toggle-icon::before {
    top: -6px;
  }

  .header__toggle-icon::after {
    top: 6px;
  }

  .header__toggle[aria-expanded='true'] .header__toggle-icon {
    background-color: transparent;
  }

  .header__toggle[aria-expanded='true'] .header__toggle-icon::before {
    transform: translateY(6px) rotate(45deg);
  }

  .header__toggle[aria-expanded='true'] .header__toggle-icon::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* 移动端折叠面板 */
  .mobile-nav {
    display: none;
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    box-shadow: var(--shadow-header-float);
  }

  .mobile-nav__list {
    display: flex;
    flex-direction: column;
    padding: var(--space-sm) var(--space-md);
  }

  .mobile-nav__link {
    display: block;
    padding-block: var(--space-md);
    color: var(--color-text);
    font-size: var(--fs-base);
    font-weight: var(--fw-medium);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-nav__link:last-child {
    border-bottom: none;
  }

  .mobile-nav__link.is-active {
    color: var(--color-brand);
    font-weight: var(--fw-semibold);
  }

  /* 响应式：≤768px 切换为移动导航
   * 移动端：页眉贴顶 top:0，近屏宽，仅保留少量左右边距。
   */
  @media (max-width: 768px) {
    .header {
      top: 0;
      margin-top: 0;
      margin-inline: var(--space-xs, 8px);
      max-width: none;
      border-radius: var(--radius-md, 8px);
    }

    .header__inner {
      min-height: var(--height-header-mobile);
      gap: var(--space-sm);
      padding-inline: var(--space-sm);
    }

    .header__brief {
      display: none;
    }

    .header__nav {
      display: none;
    }

    .header__toggle {
      display: inline-flex;
    }

    .mobile-nav {
      display: block;
      /* 移动端折叠面板继承页眉的圆角与边框 */
      border-radius: var(--radius-md, 8px);
      margin-top: var(--space-2xs, 4px);
    }
  }

  /* 尊重 prefers-reduced-motion：禁用 transform 过渡 */
  @media (prefers-reduced-motion: reduce) {
    .header {
      transition: opacity var(--transition-fast, 150ms) ease;
    }

    body[data-header-hidden='true'] #site-header {
      transform: none;
      transition-delay: 0ms;
    }

    body.has-reading-bar[data-header-hidden='false'] #site-header {
      transition-delay: 0ms;
    }
  }
</style>
