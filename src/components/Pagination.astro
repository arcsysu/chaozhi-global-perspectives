---
/**
 * Pagination.astro — 分页导航组件
 *
 * 在文章列表下方居中显示分页导航：上一页、页码、下一页。
 * 当前页使用品牌紫色突出；页数较多时用省略号折叠。
 * 全部使用真正的 <a href> 链接，支持键盘访问、刷新、复制 URL、浏览器前进后退。
 *
 * 用法：
 * <Pagination
 *   basePath="/topics/HPC/"
 *   current={2}
 *   pages={5}
 *   total={42}
 *   anchor="#latest-articles"  // 可选：跳转锚点，定位到列表顶部
 * />
 */
import { getPageItems, pageUrl, type PageItem } from '@/utils/pagination';
import { withBase } from '@/utils/site';

interface Props {
  /** 列表第一页的基础路径（不含 BASE_URL，以 / 开头，以 / 结尾） */
  basePath: string;
  /** 当前页码（从 1 开始） */
  current: number;
  /** 总页数 */
  pages: number;
  /** 文章总数（用于显示提示文本，可选） */
  total?: number;
  /** 跳转锚点（如 #latest-articles），使分页后定位到列表顶部而非页面顶端 */
  anchor?: string;
}

const { basePath, current, pages, total, anchor = '' } = Astro.props;

// 页码序列（含省略号）
const items: PageItem[] = getPageItems(current, pages);
// 仅一页时不渲染
if (pages <= 1) return;

// 辅助：生成带锚点的分页 URL
function hrefFor(page: number): string {
  const url = withBase(pageUrl(basePath, page));
  return anchor ? `${url}${anchor}` : url;
}

// 上一页/下一页页码
const hasPrev = current > 1;
const hasNext = current < pages;
---

<nav class="pagination" aria-label="文章分页导航">
  {/* 页面信息：当前页/总页数/总篇数（total 可选，仅在有值时显示） */}
  {total != null && total > 0 && (
    <p class="pagination__info" aria-hidden="true">
      第 {current} / {pages} 页，共 {total} 篇
    </p>
  )}
  {/* 上一页 */}
  {hasPrev ? (
    <a
      href={hrefFor(current - 1)}
      class="pagination__link pagination__link--prev"
      aria-label="上一页"
      rel="prev"
    >
      <span class="pagination__arrow" aria-hidden="true">‹</span>
      <span class="pagination__label">上一页</span>
    </a>
  ) : (
    <span class="pagination__link pagination__link--prev pagination__link--disabled" aria-disabled="true">
      <span class="pagination__arrow" aria-hidden="true">‹</span>
      <span class="pagination__label">上一页</span>
    </span>
  )}

  {/* 页码序列 */}
  <ul class="pagination__list" role="list">
    {items.map((item) => (
      item === '...' ? (
        <li class="pagination__ellipsis" aria-hidden="true">…</li>
      ) : (
        <li>
          {item === current ? (
            <span
              class="pagination__link pagination__link--current"
              aria-current="page"
              aria-label={`第 ${item} 页，当前页`}
            >
              {item}
            </span>
          ) : (
            <a
              href={hrefFor(item)}
              class="pagination__link"
              aria-label={`第 ${item} 页`}
            >
              {item}
            </a>
          )}
        </li>
      )
    ))}
  </ul>

  {/* 下一页 */}
  {hasNext ? (
    <a
      href={hrefFor(current + 1)}
      class="pagination__link pagination__link--next"
      aria-label="下一页"
      rel="next"
    >
      <span class="pagination__label">下一页</span>
      <span class="pagination__arrow" aria-hidden="true">›</span>
    </a>
  ) : (
    <span class="pagination__link pagination__link--next pagination__link--disabled" aria-disabled="true">
      <span class="pagination__label">下一页</span>
      <span class="pagination__arrow" aria-hidden="true">›</span>
    </span>
  )}
</nav>

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-xs, 0.5rem);
    margin-top: var(--space-2xl, 3rem);
    padding-top: var(--space-xl, 2rem);
    border-top: 1px solid var(--color-border, #e7e4f2);
  }

  /* 页面信息文本：整行居中，位于控件上方 */
  .pagination__info {
    flex-basis: 100%;
    text-align: center;
    font-size: var(--fs-sm, 0.875rem);
    color: var(--color-text-muted, #767289);
    margin: 0 0 var(--space-sm, 0.5rem);
    padding-top: 0;
  }

  .pagination__list {
    display: flex;
    align-items: center;
    gap: var(--space-2xs, 0.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pagination__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    height: 2.25rem;
    padding-inline: var(--space-sm, 0.75rem);
    border-radius: var(--radius-md, 8px);
    font-size: var(--fs-sm, 0.875rem);
    font-weight: var(--fw-medium, 500);
    color: var(--color-text, #3d3a4e);
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      background-color var(--transition-fast, 150ms),
      color var(--transition-fast, 150ms),
      border-color var(--transition-fast, 150ms);
  }

  /* 可点击页码 hover */
  a.pagination__link:hover {
    background-color: var(--color-brand-soft, #efeaff);
    color: var(--color-brand, #6d4aff);
    border-color: var(--color-brand-border, #d9ccff);
  }

  /* 当前页：品牌紫实底白字 */
  .pagination__link--current {
    background-color: var(--color-brand, #6d4aff);
    color: #ffffff;
    font-weight: var(--fw-semibold, 600);
    cursor: default;
  }

  /* 禁用（首页无上一页 / 末页无下一页） */
  .pagination__link--disabled {
    color: var(--color-text-muted, #767289);
    opacity: 0.45;
    cursor: not-allowed;
  }

  /* 上一页/下一页：箭头样式 */
  .pagination__link--prev,
  .pagination__link--next {
    padding-inline: var(--space-md, 1rem);
  }

  .pagination__arrow {
    font-size: 1.1em;
    line-height: 1;
  }

  .pagination__label {
    /* 桌面端显示文字，移动端仅显示箭头 */
  }

  .pagination__ellipsis {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    height: 2.25rem;
    color: var(--color-text-muted, #767289);
    user-select: none;
  }

  /* 移动端：隐藏"上一页/下一页"文字，仅保留箭头；减少页码间距 */
  @media (max-width: 480px) {
    .pagination__label {
      display: none;
    }

    .pagination__link--prev,
    .pagination__link--next {
      padding-inline: var(--space-sm, 0.75rem);
    }

    .pagination__list {
      gap: 0;
    }
  }
</style>
