---
/**
 * 固定阅读栏 + 阅读进度条 (ReadingProgressBar) — 与 Header 协调切换
 *
 * 参考 Quanta Magazine 交互：
 * - 文章大标题可见时：显示正常网站 Header，阅读栏隐藏。
 * - 文章大标题离开视口后：普通 Header 上滑隐藏，阅读栏从顶部滑入。
 * - 用户向上滚动重新看到标题时：阅读栏收回，普通 Header 重新展开。
 *
 * 精简阅读栏：
 * - 左侧缩小的 YatCC Logo 占位 + 当前文章标题（单行截断）。
 * - 高度约 48–56px（与 Header 一致，避免布局跳动）。
 * - 底部 2–3px 紫色阅读进度线。
 *
 * 协调机制（与 Header 互斥，不重叠）：
 * - body.has-reading-bar：标记当前页有阅读栏，Header 展开延迟 150ms 等阅读栏收回。
 * - 阅读栏显示（hidden→visible）延迟 150ms，等普通 Header 先上滑隐藏。
 * - 阅读栏隐藏（visible→hidden）无延迟，立即收回，普通 Header 随后展开。
 * - 两者始终贴顶 top:0，不留空隙。
 *
 * 实现：
 * - IntersectionObserver 监测文章标题可见性，切换 data-visible 属性。
 * - requestAnimationFrame 节流滚动计算进度。
 * - 进度范围仅文章正文（.article-body），不含页底导航和 Footer。
 * - 兼容 prefers-reduced-motion、移动端、窗口尺寸变化。
 * - 锚点跳转偏移由 CSS scroll-margin-top 处理。
 */

interface Props {
  /** 文章标题 */
  title: string;
  /** 返回链接 */
  backHref: string;
  backLabel: string;
}

const { title, backHref, backLabel } = Astro.props;
---

<div class="reading-bar" id="reading-bar" aria-hidden="true" data-visible="false">
  <div class="reading-bar__inner">
    <a
      href={backHref}
      class="reading-bar__logo"
      aria-label={backLabel}
      data-back-nav
      data-back-href={backHref}
    >
      {/* 缩小的 YatCC Logo 占位 */}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
    </a>
    <span class="reading-bar__title" title={title}>{title}</span>
  </div>
  <div class="reading-bar__progress-track">
    <div class="reading-bar__progress-fill" id="reading-progress-fill"></div>
  </div>
</div>

<script>
  // ──────────────────────────────────────────────
  // Header ↔ 阅读栏切换 + 进度条更新
  //
  // ClientRouter 兼容性：
  // - 原实现 document.body.classList.add('has-reading-bar') 在离开文章页时未移除，
  //   导致 Header 的 150ms 展开延迟泄漏到非文章页。现用 astro:before-swap 清理。
  // - IntersectionObserver / scroll / resize 监听在离开文章页时需断开/移除，
  //   避免引用已分离 DOM 与监听累积。用 astro:page-load 在进入文章页时重新初始化。
  // ──────────────────────────────────────────────

  // 模块作用域句柄：离开文章页时调用 cleanup 断开 observer + 移除监听 + 清 body 标记
  let readingBarCleanup: (() => void) | null = null;

  function initReadingBar(): void {
    // 先清理上一轮残留（若存在）
    readingBarCleanup?.();
    readingBarCleanup = null;

    const readingBar = document.getElementById('reading-bar');
    const progressFill = document.getElementById('reading-progress-fill');
    const articleTitle = document.querySelector<HTMLElement>('.article-head__title');
    const articleBody = document.querySelector<HTMLElement>('.article-body');

    // 非文章页：无阅读栏元素，移除可能残留的 body 标记后返回
    if (!readingBar) {
      document.body.classList.remove('has-reading-bar');
      return;
    }

    // 标记当前页有阅读栏，Header 展开延迟由此触发
    document.body.classList.add('has-reading-bar');

    if (articleTitle && articleBody) {
      let barVisible = false;
      let ticking = false;

      // 用 IntersectionObserver 监测文章标题可见性
      // 标题完全离开视口顶部时切换为阅读栏
      const titleObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            // 标题离开视口顶部（boundingClientRect.top < 0）时显示阅读栏
            const shouldShow = !entry.isIntersecting && entry.boundingClientRect.top < 0;
            if (shouldShow !== barVisible) {
              barVisible = shouldShow;
              // 阅读栏显示时，隐藏普通 Header（互斥）；阅读栏收回时，恢复 Header
              document.body.setAttribute('data-header-hidden', String(shouldShow));
              // 用 data 属性驱动 CSS transform 动画（不用 hidden 属性，避免 display:none 破坏过渡）
              readingBar.setAttribute('data-visible', String(shouldShow));
              readingBar.setAttribute('aria-hidden', String(!shouldShow));
            }
          }
        },
        { rootMargin: '0px', threshold: 0 },
      );
      titleObserver.observe(articleTitle);

      // 计算并更新进度条
      function updateProgress(): void {
        if (!progressFill || !articleBody) return;
        const rect = articleBody.getBoundingClientRect();
        const viewportHeight = window.innerHeight;
        // 正文顶部到视口顶部的距离（负数表示已滚入视口上方）
        const scrolled = Math.max(0, -rect.top);
        // 总可滚动距离 = 正文高度 - 视口高度
        const totalScrollable = Math.max(1, rect.height - viewportHeight);
        const progress = Math.min(1, Math.max(0, scrolled / totalScrollable));
        progressFill.style.transform = `scaleX(${progress})`;
        ticking = false;
      }

      function onScroll(): void {
        if (!ticking) {
          window.requestAnimationFrame(updateProgress);
          ticking = true;
        }
      }

      // 初始更新一次
      updateProgress();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', updateProgress, { passive: true });

      // 注册清理：离开文章页时断开 observer + 移除监听 + 重置阅读栏可见状态
      readingBarCleanup = () => {
        titleObserver.disconnect();
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', updateProgress);
        // 重置阅读栏为隐藏，避免 persist Header 看到 150ms 延迟残留
        readingBar.setAttribute('data-visible', 'false');
        readingBar.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('has-reading-bar');
      };
    } else {
      // 有 reading-bar 元素但缺 title/body：仍需清理 body 标记
      readingBarCleanup = () => {
        document.body.classList.remove('has-reading-bar');
      };
    }
  }

  // astro:before-swap：站内导航离开当前页前触发。
  // 断开 observer + 移除监听 + 清 body.has-reading-bar，避免泄漏到非文章页。
  document.addEventListener('astro:before-swap', () => {
    readingBarCleanup?.();
    readingBarCleanup = null;
  });

  // astro:page-load：每次页面加载后触发（含 ClientRouter 导航后）。
  // 文章页：初始化阅读栏；非文章页：清理残留标记。
  document.addEventListener('astro:page-load', initReadingBar);

  // 首次加载兜底（astro:page-load 在 ClientRouter 下会触发，此处兼容 SSR 直达）
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReadingBar, { once: true });
  } else {
    initReadingBar();
  }
</script>

<style>
  /* 阅读栏：固定定位，与 Header 同高，transform 滑入滑出
   * — data-visible="false"：translateY(-100%) 隐藏在视口上方
   * — data-visible="true"：translateY(0) 滑入显示
   * — 显示（hidden→visible）延迟 150ms，等普通 Header 先上滑隐藏，避免叠加。
   * — 隐藏（visible→hidden）无延迟，立即收回。
   * — pointer-events 在隐藏时关闭，避免遮挡点击。
   */
  .reading-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-header, 100);
    background-color: var(--color-surface, #ffffff);
    box-shadow: var(--shadow-header-float, 0 2px 12px rgba(43, 38, 64, 0.08));
    transform: translateY(-100%);
    transition: transform var(--transition-base, 250ms) cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
    pointer-events: none;
  }

  /* 阅读栏可见时滑入（显示延迟 150ms，等 Header 先隐藏） */
  .reading-bar[data-visible='true'] {
    transform: translateY(0);
    pointer-events: auto;
    transition-delay: 150ms;
  }

  .reading-bar__inner {
    max-width: var(--width-content, 72rem);
    margin-inline: auto;
    padding-inline: var(--space-lg, 24px);
    height: var(--height-header, 4rem); /* 与 Header 同高，避免布局跳动 */
    display: flex;
    align-items: center;
    gap: var(--space-sm, 12px);
  }

  .reading-bar__logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm, 4px);
    color: var(--color-brand, #6d4aff);
    flex-shrink: 0;
    text-decoration: none;
  }

  .reading-bar__logo:hover {
    background-color: var(--color-brand-soft, #efeaff);
  }

  .reading-bar__title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: var(--fs-sm, 14px);
    font-weight: var(--fw-medium, 500);
    color: var(--color-heading, #2b2640);
    line-height: var(--lh-tight, 1.2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .reading-bar__progress-track {
    height: 3px;
    background-color: var(--color-border, #e7e4f2);
    overflow: hidden;
  }

  .reading-bar__progress-fill {
    height: 100%;
    background-color: var(--color-brand, #6d4aff);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 50ms linear;
  }

  /* 移动端：阅读栏更紧凑 */
  @media (max-width: 767px) {
    .reading-bar__inner {
      height: var(--height-header-mobile, 3.5rem);
      padding-inline: var(--space-md, 16px);
    }

    .reading-bar__title {
      font-size: var(--fs-xs, 12px);
    }
  }

  /* 尊重 prefers-reduced-motion：禁用过渡与延迟 */
  @media (prefers-reduced-motion: reduce) {
    .reading-bar {
      transition: none;
    }

    .reading-bar[data-visible='true'] {
      transition-delay: 0ms;
    }

    .reading-bar__progress-fill {
      transition: none;
    }
  }
</style>

<!--
  Header 隐藏/展开由 body[data-header-hidden] 属性驱动，规则定义在 Header.astro 的
  scoped <style> 中。本组件通过 IntersectionObserver 切换 data-header-hidden 与
  reading-bar 的 data-visible，实现两者互斥协调。
-->
